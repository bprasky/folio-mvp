# Folio Environment Variables
# Copy this file to .env.local and fill in your values

# Database
DATABASE_URL=
DIRECT_URL=
# Local shadow DB for `prisma migrate dev` (see docker-compose.prisma-shadow.yml).
# Supabase does not permit Prisma to auto-create a shadow DB; run the local
# pgvector-enabled Postgres on port 5433 via `pnpm run prisma:shadow:up`.
SHADOW_DATABASE_URL=

# Authentication
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI Services
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Web Scraping
# Browserless API key for rendered page scraping (product and portfolio imports).
BROWSERLESS_API_KEY=

# 3D Mesh Generation (fal.ai)
FAL_KEY=                          # fal.ai API key (https://fal.ai/dashboard/keys)

# ============================================
# Real-time Interview Infrastructure
# ============================================

# LiveKit - Real-time audio/video
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=wss://your-app.livekit.cloud

# Deepgram - Streaming speech-to-text
DEEPGRAM_API_KEY=

# Cartesia - Natural text-to-speech
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=sofia-editorial

# Orchestration Service
ORCHESTRATION_SERVICE_URL=http://localhost:3001
ORCHESTRATION_SERVICE_SECRET=

# Feature flags
REALTIME_INTERVIEW_ENABLED=true
REALTIME_INTERVIEW_MAX_DURATION_MS=1800000
NEXT_PUBLIC_FLAG_REALTIME_INTERVIEW=1

# Adaptive thinking (Sonnet 5) — OFF by default, opt in per surface.
#
# Thinking tokens bill as OUTPUT tokens ($15/MTok, not the $3 input side) and
# share the max_tokens budget with the response, so each surface is enabled
# deliberately and measured. Leave unset to keep the behavior the Sonnet 5
# migration shipped (thinking disabled everywhere).
#
#   editorial  — the article generator. Async and quality-sensitive; the safe
#                place to start, since latency is nearly free on a ~2min call.
#   followups  — interview follow-up questions. The designer is WAITING on these,
#                so thinking latency is user-visible. Enable second, if at all.
#
# Comma-separated, e.g. ADAPTIVE_THINKING_SURFACES=editorial
ADAPTIVE_THINKING_SURFACES=
# low | medium | high | xhigh | max. Defaults to `low` — Sonnet 5's own default
# is `high`, which is a bigger jump than a move off thinking-disabled wants
# (Sonnet 5 at `medium` is already ~Sonnet 4.6 at `high`).
ADAPTIVE_THINKING_EFFORT=
