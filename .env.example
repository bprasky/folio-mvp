# Folio Environment Variables
# Copy this file to .env.local and fill in your values

# Database
#
# DATABASE_URL is what the app queries through at runtime, so on a serverless
# host it must point at Supavisor's TRANSACTION pooler — port 6543:
#
#   postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:6543/postgres
#
# NOT port 5432. Port 5432 is the SESSION pooler, where each client connection is
# pinned to a Postgres backend for the life of the session and the pool is 15.
# Prisma opens several connections per lambda instance and holds them while the
# instance stays warm, and a deploy briefly runs the old and new fleets at once —
# so 5432 exhausts the pool on almost every push and every route 500s with
#
#   FATAL: (EMAXCONNSESSION) max clients reached in session mode
#
# until the old instances idle out, which is the "wait half an hour before you
# can test" symptom. Transaction mode multiplexes and does not pin, so the same
# traffic fits.
#
# src/lib/prisma.ts adds connection_limit=1 (and pgbouncer=true on 6543) when the
# URL does not already set them, which raises the ceiling a great deal — but it
# cannot turn session mode into transaction mode. Use 6543.
DATABASE_URL=
# Migrations and introspection only — Prisma needs a real, unpooled session for
# advisory locks and DDL, so this one is the direct connection (port 5432).
DIRECT_URL=
# Local shadow DB for `prisma migrate dev` (see docker-compose.prisma-shadow.yml).
# Supabase does not permit Prisma to auto-create a shadow DB; run the local
# pgvector-enabled Postgres on port 5433 via `pnpm run prisma:shadow:up`.
SHADOW_DATABASE_URL=

# Authentication
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI Services
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Web Scraping
# Browserless API key for rendered page scraping (product and portfolio imports).
BROWSERLESS_API_KEY=

# 3D Mesh Generation (fal.ai)
FAL_KEY=                          # fal.ai API key (https://fal.ai/dashboard/keys)

# ============================================
# Real-time Interview Infrastructure
# ============================================

# LiveKit - Real-time audio/video
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=wss://your-app.livekit.cloud

# Deepgram - Streaming speech-to-text
DEEPGRAM_API_KEY=

# Cartesia - Natural text-to-speech
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=sofia-editorial

# Orchestration Service
ORCHESTRATION_SERVICE_URL=http://localhost:3001
ORCHESTRATION_SERVICE_SECRET=

# Feature flags
REALTIME_INTERVIEW_ENABLED=true
REALTIME_INTERVIEW_MAX_DURATION_MS=1800000
NEXT_PUBLIC_FLAG_REALTIME_INTERVIEW=1

# Adaptive thinking (Sonnet 5) — OFF by default, opt in per surface.
#
# Thinking tokens bill as OUTPUT tokens ($15/MTok, not the $3 input side) and
# share the max_tokens budget with the response, so each surface is enabled
# deliberately and measured. Leave unset to keep the behavior the Sonnet 5
# migration shipped (thinking disabled everywhere).
#
#   editorial  — the article generator. Async and quality-sensitive; the safe
#                place to start, since latency is nearly free on a ~2min call.
#   followups  — interview follow-up questions. The designer is WAITING on these,
#                so thinking latency is user-visible. Enable second, if at all.
#
# Comma-separated, e.g. ADAPTIVE_THINKING_SURFACES=editorial
ADAPTIVE_THINKING_SURFACES=
# low | medium | high | xhigh | max. Defaults to `low` — Sonnet 5's own default
# is `high`, which is a bigger jump than a move off thinking-disabled wants
# (Sonnet 5 at `medium` is already ~Sonnet 4.6 at `high`).
ADAPTIVE_THINKING_EFFORT=

# P0 security: required on every production instance. Share one Redis database.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Resend webhook signing secret (whsec_...), required even for email.test events.
RESEND_WEBHOOK_SECRET=
# Internal Linux renderer. Exact HTTPS /render endpoint; minimum 32-character key.
# Deploy and pass services/render-worker acceptance before enabling.
RENDER_WORKER_URL=
RENDER_WORKER_API_KEY=
