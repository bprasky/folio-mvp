# Folio Environment Variables
# Copy this file to .env.local and fill in your values

# Database
DATABASE_URL=
DIRECT_URL=
# Local shadow DB for `prisma migrate dev` (see docker-compose.prisma-shadow.yml).
# Supabase does not permit Prisma to auto-create a shadow DB; run the local
# pgvector-enabled Postgres on port 5433 via `pnpm run prisma:shadow:up`.
SHADOW_DATABASE_URL=

# Authentication
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI Services
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Web Scraping
# Browserless API key for rendered page scraping (product and portfolio imports).
BROWSERLESS_API_KEY=

# 3D Mesh Generation (fal.ai)
FAL_KEY=                          # fal.ai API key (https://fal.ai/dashboard/keys)

# ============================================
# Real-time Interview Infrastructure
# ============================================

# LiveKit - Real-time audio/video
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=wss://your-app.livekit.cloud

# Deepgram - Streaming speech-to-text
DEEPGRAM_API_KEY=

# Cartesia - Natural text-to-speech
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=sofia-editorial

# Orchestration Service
ORCHESTRATION_SERVICE_URL=http://localhost:3001
ORCHESTRATION_SERVICE_SECRET=

# Feature flags
REALTIME_INTERVIEW_ENABLED=true
REALTIME_INTERVIEW_MAX_DURATION_MS=1800000
NEXT_PUBLIC_FLAG_REALTIME_INTERVIEW=1
