# root-owned /etc/folio-render.env, mode 0600. Never copy this into the image.
RENDER_API_KEY=
# Rotation: accept one prior key until all Folio instances use the new key.
RENDER_API_KEY_PREVIOUS=
# Immutable local docker image ID, from docker image inspect, sha256:...
RENDER_IMAGE_ID=
RENDER_DNS_IPV4=1.1.1.1
# Comma-separated extra IPv4 control-plane/proxy/load-balancer addresses.
# All local host addresses and Docker gateways are discovered and denied too.
RENDER_BLOCKED_IPV4=
