{
  "name": "folio-mvp",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:clean": "rm -rf .next && next dev",
    "dev:safe": "powershell -Command \"Remove-Item -Recurse -Force .next -ErrorAction SilentlyContinue; next dev\"",
    "dev:protected": "node src/protect-changes.js && npm run clear-cache && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "audit:dash": "cross-env NODE_OPTIONS='-r ./scripts/readonly-guard.js' ts-node scripts/audit-dashboard.ts",
    "audit:dash:json": "cross-env NODE_OPTIONS='-r ./scripts/readonly-guard.js' JSON=1 ts-node scripts/audit-dashboard.ts",
    "audit:smoke": "cross-env NODE_OPTIONS='-r ./scripts/readonly-guard.js' node scripts/readonly-smoke.js",
    "audit:product": "node scripts/audit-product.mjs",
    "audit:product:rove": "cross-env AUDIT_NAME=\"Terra Travertine Side Table\" AUDIT_VENDOR=\"Rove Concepts\" node scripts/audit-product.mjs",
    "check:digest": "tsx scripts/check-editorial-queue-digest.ts",
    "check:angles": "tsx scripts/check-editorial-queue-angles.ts",
    "check:naming": "tsx scripts/check-product-naming.ts",
    "check:vendors": "node scripts/check-vendors.mjs",
    "create:vendor": "node scripts/create-vendor.mjs",
    "create:vendor:rove": "cross-env VENDOR_NAME=\"Rove Concepts\" VENDOR_EMAIL=\"rove@example.com\" node scripts/create-vendor.mjs",
    "create:test-product": "node scripts/create-test-product.mjs",
    "fix:imageurls": "node scripts/fix-image-urls.mjs",
    "fix:tola": "node scripts/fix-tola-image.mjs",
    "test:lighthouse": "node scripts/lighthouse-test.mjs",
    "check:audit": "git update-index -q --refresh && git diff --quiet || (echo \"\\n⚠️ Working tree not clean before audit\" && exit 2); cross-env NODE_OPTIONS='-r ./scripts/readonly-guard.js' ts-node scripts/audit-dashboard.ts; git update-index -q --refresh && git diff --quiet || (echo \"\\n❌ Files changed during audit (read-only violation)\" && git --no-pager diff && exit 3)",
    "clear-cache": "powershell -Command \"Remove-Item -Recurse -Force .next -ErrorAction SilentlyContinue\"",
    "reset-files": "powershell -Command \"Get-ChildItem -Recurse -Filter '*.backup' | Remove-Item -Force\"",
    "backfill:classification": "npx tsx scripts/backfill-image-classification.ts",
    "backfill:moments": "tsx scripts/backfill-moment-index.ts",
    "backfill:moments:dry": "tsx scripts/backfill-moment-index.ts --dry-run",
    "backfill:moments:skip-existing": "tsx scripts/backfill-moment-index.ts --skip-existing",
    "export:training-data": "npx tsx scripts/export-verification-training-data.ts",
    "protect": "node src/protect-changes.js",
    "restore": "node src/protect-changes.js restore",
    "setup-db": "node src/scripts/setup-database.js",
    "migrate-data": "node src/scripts/migrate-data.js",
    "test-roles": "node src/scripts/test-role-assignment.js",
    "setup-nextauth": "node src/scripts/setup-nextauth-env.js",
    "copy-env": "node src/scripts/copy-env.js",
    "prisma:seed:nycx": "ts-node --compiler-options \"{\\\"module\\\":\\\"CommonJS\\\"}\" prisma/seed-nycx.ts",
    "auth:detect": "tsx scripts/auth-detect.ts",
    "auth:detect:simple": "node scripts/auth-detect-simple.js",
    "db:check": "tsx scripts/db-check.ts",
    "test:auth": "node scripts/test-auth-endpoints.js",
    "db:guard": "tsx scripts/guard-migrations.ts",
    "db:backup": "tsx scripts/backup-db.ts",
    "migrate:safe": "npm run db:guard && npm run db:backup && prisma migrate dev",
    "migrate:create-only": "npm run db:guard && prisma migrate dev --create-only",
    "migrate:deploy": "npm run db:guard && prisma migrate deploy",
    "seed:min": "tsx scripts/seed-minimal.ts",
    "create:demo": "tsx scripts/create-demo-user.ts",
    "check-env": "tsx scripts/check-env.ts",
    "test:service-key": "node scripts/test-supabase-service-key.mjs",
    "guard:client-imports": "node scripts/guard-client-imports.js",
    "diag": "node scripts/diag.mjs",
    "audit:events": "node scripts/audit-events.mjs",
    "bucket:list": "node scripts/list-buckets.mjs",
    "bucket:create": "node scripts/create-storage-bucket.mjs",
    "seed": "prisma db seed",
    "migrate:create": "prisma migrate dev --create-only",
    "migrate:direct": "tsx scripts/migrate-with-direct.ts",
    "migrate:apply-sql": "tsx scripts/apply-migration-sql.ts",
    "schema:push": "prisma generate && prisma db push",
    "db:sync-and-seed": "npm run schema:push && npm run seed",
    "jobs:embed": "tsx src/jobs/embedding-updater.ts",
    "jobs:edges": "tsx src/jobs/edge-builder.ts",
    "jobs:decay": "tsx src/jobs/edge-decay.ts",
    "jobs:all": "npm run jobs:embed && npm run jobs:edges && npm run jobs:decay",
    "jobs:3d-backfill": "npx tsx scripts/backfill-3d-meshes.ts",
    "jobs:3d-tag-backfill": "npx tsx scripts/backfill-3d-tag-meshes.ts",
    "backfill:moments:fields": "tsx scripts/backfill-moment-index-fields.ts",
    "fix:null-tags": "tsx scripts/fix-null-combined-tags.ts",
    "check:schema": "tsx scripts/check-and-fix-moment-index-schema.ts",
    "clean:cache": "node scripts/clean-prisma-cache.js",
    "prisma:reset": "node scripts/clean-prisma-cache.js && prisma generate",
    "dev:fresh": "node scripts/clean-prisma-cache.js && prisma generate && npm run dev",
    "prisma:status": "prisma migrate status",
    "prisma:shadow:up": "docker compose -f docker-compose.prisma-shadow.yml up -d",
    "prisma:shadow:down": "docker compose -f docker-compose.prisma-shadow.yml down",
    "prisma:shadow:reset": "docker compose -f docker-compose.prisma-shadow.yml down -v && docker compose -f docker-compose.prisma-shadow.yml up -d",
    "verify:prisma": "npx tsx scripts/verify-prisma-sync.ts",
    "fix:null-arrays": "npx tsx scripts/fix-null-array-fields.ts",
    "test:search": "npx tsx scripts/test-search.ts",
    "debug:prisma": "npx tsx scripts/debug-prisma-types.ts",
    "fix:null-elements": "npx tsx scripts/fix-null-array-elements.ts",
    "security:idor": "tsx scripts/security/idor-scan.ts",
    "security:idor:ci": "tsx scripts/security/idor-scan.ts --ci"
  },
  "buildTimestamp": "2025-01-18T20:15:00Z",
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "node prisma/seed.js"
  },
