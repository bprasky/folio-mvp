{
  "git": {
    "deploymentEnabled": false
  },
  "regions": [
    "iad1"
  ],
  "installCommand": "npm install --legacy-peer-deps",
  "buildCommand": "prisma generate && node scripts/diagnose-private-room-connection.cjs",
  "crons": [
    {
      "path": "/api/cron/live-interviews",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/workspace-imports",
      "schedule": "* * * * *"
    }
  ]
}
