// ============================================================
// INTELLIGENCE SYSTEM - User taste signals, patterns, and profiles
// See docs/12_INTELLIGENCE_SYSTEM.md for full specification
// ============================================================

// Layer 1: Signal Capture - Likes (impulsive engagement)
model Like {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  // Extracted attributes (populated async from product)
  productAttributes Json? // { colors: [], materials: [], shapes: [], styles: [] }

  user    User    @relation("UserLikes", fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation("ProductLikes", fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId, createdAt])
  @@index([productId])
  @@map("likes")
}

// Layer 1: Signal Capture - Saves (intentional engagement)
model Save {
  id        String @id @default(cuid())
  userId    String
  productId String

  // Organization
  boardId  String?
  roomType String? // "living_room", "bedroom", "kitchen", etc.

  // Extracted attributes (populated async from product)
  productAttributes Json? // { colors: [], materials: [], shapes: [], styles: [] }

  // Provenance
  source String? // e.g. "EVENT_SCAN", "MANUAL", "BROWSE"
  meta   Json?   // e.g. { eventId, scannedAt }

  // Conversion tracking
  converted   Boolean   @default(false)
  convertedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation("UserSaves", fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation("ProductSaves", fields: [productId], references: [id], onDelete: Cascade)
  board   Board?  @relation(fields: [boardId], references: [id], onDelete: SetNull)

  @@unique([userId, productId])
  @@index([userId, boardId])
  @@index([userId, createdAt])
  @@index([productId])
  @@map("saves")
}

// Layer 1 & 5: Boards for organizing saves
model Board {
  id       String  @id @default(cuid())
  userId   String
  name     String
  type     String // 'room', 'style', 'inspiration', 'auto'
  roomType String? // If type='room': 'living_room', 'bedroom', etc.

  // Auto-generated boards track their source
  autoGenerated Boolean @default(false)
  autoSource    String? // 'room_clustering', 'style_clustering'

  // Cover image (first save's product image or custom)
  coverImageUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User   @relation("UserBoards", fields: [userId], references: [id], onDelete: Cascade)
  saves Save[]

  @@index([userId])
  @@index([userId, type])
  @@map("boards")
}

// Layer 2: Pattern Inference - Detected taste patterns
model TasteInference {
  id     String @id @default(cuid())
  userId String

  attribute     String // "curved", "green", "velvet", "warm_modern"
  attributeType String // "shape", "color", "material", "style"

  confidence Float // 0-1 based on pattern strength
  evidence   String // Human-readable explanation
  source     String // "frequency", "cross_pattern", "clustering"

  // User confirmation
  confirmedByUser Boolean? // null = not asked, true = yes, false = no
  confirmedAt     DateTime?

  // Display tracking
  shownToUser Boolean   @default(false)
  shownAt     DateTime?
  dismissedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation("UserTasteInferences", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, attribute])
  @@index([userId, confirmedByUser])
  @@index([userId, shownToUser])
  @@map("taste_inferences")
}

// Layer 5: User Taste Profile - Self-discovery dashboard
model UserTasteProfile {
  id     String @id @default(cuid())
  userId String @unique

  // AI-generated summary
  styleName        String? // "Warm Modern with Art Deco influence"
  styleDescription String? @db.Text // Full paragraph description

  // Confirmed preferences (high confidence)
  confirmedAttributes String[]

  // Stats
  totalLikes      Int   @default(0)
  totalSaves      Int   @default(0)
  profileStrength Float @default(0) // 0-1 based on confirmations

  // Milestones
  firstInsightAt DateTime?
  styleNamedAt   DateTime?

  // Fingerprint vector for matching
  fingerprintVector Json? // Numeric vector for similarity matching

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation("UserTasteProfile", fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_taste_profiles")
}

// Layer 6: Supplemental Quotes - Per-product, per-contributor commentary
// These preserve the full uncompressed interview answers about specific products.
// The AI editorial is the highlight reel; these are the director's commentary.
model SupplementalQuote {
  id            String  @id @default(cuid())
  projectPostId String
  productTagId  String? // If quote is about a specific product

  // Multi-party attribution
  userId          String? // Contributor who said this (designer, architect, contractor, vendor)
  contributorRole String? // Role at time of contribution: "Designer", "Architect", "Contractor", "Vendor"
  user            User?   @relation("UserSupplementalQuotes", fields: [userId], references: [id], onDelete: SetNull)

  question String
  answer   String @db.Text
  source   String // 'interview', 'welcome_back', 'trend_interview', 'user_question'

  // Display control
  pinned          Boolean @default(false)
  displayLocation String? // 'near_product', 'sidebar', 'end_of_post', 'vendor_tab'

  createdAt DateTime @default(now())

  post       ProjectPost @relation("PostSupplementalQuotes", fields: [projectPostId], references: [id], onDelete: Cascade)
  productTag ProductTag? @relation("ProductTagQuotes", fields: [productTagId], references: [id], onDelete: SetNull)

  @@index([projectPostId])
  @@index([productTagId])
  @@index([userId])
  @@map("supplemental_quotes")
}

// Layer 6: Trend Detection - Rising signals across platform
model TrendSignal {
  id String @id @default(cuid())

  signalType String // 'search', 'save', 'like', 'tag_density'
  topic      String // 'green chair', 'brass fixtures', 'curved sofa'
  topicType  String // 'product', 'color', 'material', 'shape', 'style'

  // Metrics
  currentVolume  Int // This period's count
  previousVolume Int // Last period's count
  growthRate     Float // Percentage increase
  magnitude      Float // How strong is the spike (0-1)

  // Related entities
  topProducts  String[] // Product IDs driving the trend
  topDesigners String[] // Designers who tagged trending items

  // Status
  status String @default("detected") // 'detected', 'interviewing', 'published', 'expired'

  // Output
  generatedArticleId String?

  detectedAt DateTime @default(now())
  expiresAt  DateTime

  interviewRequests TrendInterviewRequest[]

  // Contributor/Voice System relations
  generatedTopics ArticleTopic[] @relation("TrendGeneratedTopics")

  @@index([status])
  @@index([topicType])
  @@index([detectedAt])
  @@map("trend_signals")
}

// Layer 6: Trend Interview Requests - Designer micro-interviews
model TrendInterviewRequest {
  id            String  @id @default(cuid())
  trendSignalId String
  designerId    String
  projectId     String
  productTagId  String?

  // The question (AI-generated based on trend)
  question String

  // Response
  answer     String?   @db.Text
  answeredAt DateTime?

  // Status
  status String @default("pending") // 'pending', 'answered', 'skipped', 'expired'

  // Quality signals
  engagementScore Float? // How good is this project for the trend

  createdAt DateTime @default(now())
  expiresAt DateTime

  trendSignal TrendSignal @relation(fields: [trendSignalId], references: [id], onDelete: Cascade)
  designer    User        @relation("DesignerTrendInterviews", fields: [designerId], references: [id], onDelete: Cascade)
  project     Project     @relation("ProjectTrendInterviews", fields: [projectId], references: [id], onDelete: Cascade)

  @@index([trendSignalId])
  @@index([designerId, status])
  @@index([projectId])
  @@map("trend_interview_requests")
}

// Layer 7: Vendor Content Opportunity - Monetization
model VendorContentOpportunity {
  id        String @id @default(cuid())
  vendorId  String // Organization ID
  productId String

  // Engagement that triggered this
  likeCount        Int
  saveCount        Int
  uncommittedCount Int
  designerTagCount Int

  // Distribution estimate
  tier1Reach Int // Direct engagers
  tier2Reach Int // Fingerprint matches
  tier3Reach Int // Designer followers
  totalReach Int

  // Status
  status String @default("available") // 'available', 'in_progress', 'published', 'expired'

  // If published
  articleId   String?
  publishedAt DateTime?

  createdAt DateTime @default(now())
  expiresAt DateTime // 7 days default

  vendor  Organization @relation("VendorContentOpportunities", fields: [vendorId], references: [id], onDelete: Cascade)
  product Product      @relation("ProductContentOpportunities", fields: [productId], references: [id], onDelete: Cascade)

  @@index([vendorId, status])
  @@index([productId])
  @@index([status, expiresAt])
  @@map("vendor_content_opportunities")
}

// ============================================================================
// CONTRIBUTOR/VOICE SYSTEM
// See: Implementation spec for contributor voice gathering
// ============================================================================

enum ArticleTopicStatus {
  QUEUED // In admin queue, not visible to users yet
  GATHERING // Actively collecting contributions
  THRESHOLD_MET // Min reached, can move to writing
  WRITING // Being written/edited
  REVIEW // Editorial review
  PUBLISHED // Live
  ARCHIVED // Closed without publishing
}

enum ContributionType {
  QUICK_TAKE // 2-3 sentences
  EXPERTISE // Rep product knowledge
  PREDICTION // Future trend take
  REFLECTION // Project reflection
  ENDORSEMENT // Product endorsement
  CONSUMER_VOICE // Individual perspective
}

enum ContributionStatus {
  PENDING // Awaiting review
  APPROVED // Approved for use
  SELECTED // Selected for article
  PUBLISHED // Live in article
  REJECTED // Not usable
}

enum BadgeLevel {
  VOICE // 1 published
  PERSPECTIVE // 5 published (Designer)
  SPECIALIST // 5 published (Rep)
  ENGAGED // 5 published (Individual)
  AUTHORITY // 15 published
  EDITORIAL_VOICE // 30+ published
}

enum PromptLocation {
  MAGAZINE_PAGE
  FOR_YOU_FEED
  POST_SAVE
  POST_PUBLISH
  WELCOME_BACK
  PRODUCT_PAGE
  PROJECT_DETAIL
  PROFILE_DASHBOARD
}

// Article Topic Queue - Admin-managed pipeline for upcoming articles
model ArticleTopic {
  id String @id @default(cuid())

  // Topic definition
  title          String // "The Quiet Return of Travertine"
  slug           String  @unique
  promptQuestion String  @db.Text // "What draws you to travertine right now?"
  description    String? @db.Text // Internal admin notes

  // Categorization
  category String // 'material', 'trend', 'philosophy', 'vendor', 'regional'
  tags     String[] // ['stone', 'natural', 'warm-tones']

  // Targeting - who sees this prompt
  targetRoles     String[] // ['DESIGNER', 'VENDOR', 'INDIVIDUAL']
  targetMaterials String[] // Material categories that trigger visibility
  targetStyles    String[] // Style categories
  minSaveCount    Int? // User must have X saves in related category

  // Thresholds for progression
  minContributions    Int  @default(5)
  targetContributions Int  @default(15)
  minDesigners        Int  @default(3)
  minReps             Int?
  minIndividuals      Int?

  // Status
  status ArticleTopicStatus @default(QUEUED)

  // Auto-trigger from trends
  autoTriggered   Boolean      @default(false)
  triggerSignalId String?
  triggerSignal   TrendSignal? @relation("TrendGeneratedTopics", fields: [triggerSignalId], references: [id])

  // Timing
  queuedAt           DateTime  @default(now())
  gatheringStartedAt DateTime?
  writingStartedAt   DateTime?
  publishedAt        DateTime?
  targetPublishDate  DateTime?

  // Relations
  contributions Contribution[]
  prompts       ContributionPrompt[]

  // When published, links to the article
  publishedPostId String?      @unique
  publishedPost   ProjectPost? @relation("TopicPublishedPost", fields: [publishedPostId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([category])
  @@map("article_topics")
}

// Universal voice capture - works for all user types
model Contribution {
  id String @id @default(cuid())

  // Who contributed
  userId   String
  user     User   @relation("UserContributions", fields: [userId], references: [id], onDelete: Cascade)
  userRole String // Role at time of contribution

  // What topic
  articleTopicId String
  articleTopic   ArticleTopic @relation(fields: [articleTopicId], references: [id], onDelete: Cascade)

  // Optional context anchors
  productId String? // If about specific product
  product   Product? @relation("ProductContributions", fields: [productId], references: [id])
  projectId String? // If reflecting on project
  project   Project? @relation("ProjectContributions", fields: [projectId], references: [id])
  saveId    String? // If prompted after save

  // The contribution
  type    ContributionType
  content String           @db.Text

  // Voice support (reuse existing pattern)
  audioUrl        String?
  voiceTranscript String? @db.Text

  // Editorial processing
  status        ContributionStatus @default(PENDING)
  editedContent String?            @db.Text
  pullQuote     String?

  // Publishing
  publishedInPostId String?
  publishedInPost   ProjectPost? @relation("PostContributions", fields: [publishedInPostId], references: [id])
  displayOrder      Int?

  // Share card
  shareCardUrl         String?
  shareCardGeneratedAt DateTime?
  shareCount           Int       @default(0)

  // Share card relation
  shareCard ShareCard?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, articleTopicId])
  @@index([articleTopicId, status])
  @@index([userId])
  @@index([userRole])
  @@map("contributions")
}

// Contributor recognition badges
model ContributorBadge {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("UserContributorBadges", fields: [userId], references: [id], onDelete: Cascade)

  level              BadgeLevel
  earnedAt           DateTime   @default(now())
  publishedCount     Int
  totalContributions Int

  @@unique([userId, level])
  @@map("contributor_badges")
}

// Contextual prompts for where/when to show contribution opportunities
model ContributionPrompt {
  id String @id @default(cuid())

  location PromptLocation

  // Targeting
  targetRoles     String[]
  targetMaterials String[]
  targetStyles    String[]
  minSaveCount    Int?
  minDaysActive   Int?

  // Link to topic
  articleTopicId String
  articleTopic   ArticleTopic @relation(fields: [articleTopicId], references: [id])
  customQuestion String? // Override default

  // Display
  priority        Int     @default(0)
  active          Boolean @default(true)
  maxImpressions  Int?
  impressionCount Int     @default(0)

  createdAt DateTime @default(now())

  @@index([location, active])
  @@map("contribution_prompts")
}

// Share cards for social sharing
model ShareCard {
  id String @id @default(cuid())

  contributionId String?       @unique
  contribution   Contribution? @relation(fields: [contributionId], references: [id])
  projectPostId  String?

  imageUrl     String
  quote        String @db.Text
  attribution  String
  articleTitle String
  articleUrl   String
  variant      String @default("instagram")

  generatedAt DateTime @default(now())

  @@map("share_cards")
}

// ============================================================
// DESIGNER SHOP SYSTEM
// Products curated by designers with testimonials and vendor boosts
// ============================================================

model ShopProduct {
  id              String    @id @default(cuid())
  designerId      String
  productId       String
  projectId       String? // Source project where product was tagged
  quote           String? // Designer testimonial
  quoteApprovedAt DateTime? // When quote was approved/added
  isActive        Boolean   @default(true)
  isFeatured      Boolean   @default(false) // Designer-pinned to top
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  designer    User                @relation("DesignerShopProducts", fields: [designerId], references: [id], onDelete: Cascade)
  product     Product             @relation("ProductShopProducts", fields: [productId], references: [id], onDelete: Cascade)
  project     Project?            @relation("ProjectShopProducts", fields: [projectId], references: [id], onDelete: SetNull)
  boosts      ShopBoost[]
  testimonial ProductTestimonial?

  @@unique([designerId, productId])
  @@index([designerId])
  @@index([productId])
  @@map("shop_products")
}

model ShopBoost {
  id             String          @id @default(cuid())
  shopProductId  String
  vendorId       String // Organization ID
  status         ShopBoostStatus @default(PENDING)
  startDate      DateTime
  endDate        DateTime
  amountPaid     Decimal         @db.Decimal(10, 2)
  designerCredit Decimal         @db.Decimal(10, 2) // 70% share
  folioRevenue   Decimal         @db.Decimal(10, 2) // 30% share
  approvedAt     DateTime?
  declinedAt     DateTime?
  declineReason  String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  // Relations
  shopProduct ShopProduct  @relation(fields: [shopProductId], references: [id], onDelete: Cascade)
  vendor      Organization @relation("VendorShopBoosts", fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([shopProductId])
  @@index([vendorId])
  @@index([status])
  @@map("shop_boosts")
}

model ProductTestimonial {
  id            String   @id @default(cuid())
  productId     String
  shopProductId String   @unique
  quote         String
  isFeatured    Boolean  @default(false) // Vendor-boosted
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  product     Product     @relation("ProductTestimonials", fields: [productId], references: [id], onDelete: Cascade)
  shopProduct ShopProduct @relation(fields: [shopProductId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_testimonials")
}

// ─── Vendor Invite & Presentation System ────────────────────────────────────

// Track vendor notification/claim status when designers tag vendor products
model VendorInvite {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Trigger tag (the tag that initiated the invite)
  triggerTagId String?
  triggerTag   ProductTag? @relation("VendorInviteTriggerTag", fields: [triggerTagId], references: [id], onDelete: SetNull)

  // Invite tracking
  emailSentAt   DateTime?
  emailOpenedAt DateTime?
  linkClickedAt DateTime?

  // Claim tracking
  claimedAt       DateTime?
  claimedByUserId String?
  claimedByUser   User?     @relation("VendorInvitesClaimed", fields: [claimedByUserId], references: [id], onDelete: SetNull)

  // Admin activation
  adminActivatedAt DateTime?
  adminUserId      String?
  adminUser        User?     @relation("VendorInvitesAdmin", fields: [adminUserId], references: [id], onDelete: SetNull)

  // Founding vendor program
  foundingVendorSlot Int? // null = not in program, 1-20 = slot number

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([claimedByUserId])
  @@index([adminUserId])
  @@map("vendor_invites")
}

// Track presentation scroll analytics
model VendorPresentationView {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation("VendorPresentationViews", fields: [userId], references: [id], onDelete: SetNull)

  presentationType String // "rep" or "admin"

  // Scroll analytics
  maxScrollDepth Float    @default(0) // 0-1 percentage
  sectionsViewed String[] // ["hook", "what-happened", ...]
  timeOnPageMs   Int      @default(0)

  // CTA tracking
  ctaClicked String? // which CTA was clicked

  viewToken String @unique @default(cuid())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([userId])
  @@map("vendor_presentation_views")
}

// =====================================================
// Product Cache & Relationship System
// =====================================================

// Cache of products imported from URLs, before vendor claims
model CachedProduct {
  id String @id @default(uuid())

  // URL is unique key for lookups
  url String @unique

  // Basic product info (from AI extraction)
  productName String? @map("product_name")
  brand       String?
  vendorName  String? @map("vendor_name") // Retailer/website name
  sku         String?
  priceCents  Int?    @map("price_cents") // Store in cents for precision
  currency    String  @default("USD")
  description String?

  // Image (from Browserless extraction)
  imageUrl String? @map("image_url")

  // Dimensions (inches)
  widthIn  Decimal? @map("width_in") @db.Decimal(10, 2)
  depthIn  Decimal? @map("depth_in") @db.Decimal(10, 2)
  heightIn Decimal? @map("height_in") @db.Decimal(10, 2)

  // AI Classification
  materialType    String? @map("material_type") // stone, tile, wood, fabric, metal, lighting, appliance, furniture, other
  style           String? // modern, traditional, transitional, industrial, coastal, farmhouse
  colorPalette    Json    @default("[]") @map("color_palette") // Array of dominant colors
  roomSuitability Json    @default("{}") @map("room_suitability") // { kitchen: 0.9, bathroom: 0.7, ... }
  priceTier       String? @map("price_tier") // budget, mid, premium, luxury

  // Categories/Tags
  categories String[] @default([])
  tags       String[] @default([])

  // Vendor relationship
  claimedVendorId String? @map("claimed_vendor_id")
  claimedVendor   User?   @relation("ClaimedCachedProducts", fields: [claimedVendorId], references: [id], onDelete: SetNull)
  claimedOrgId    String? @map("claimed_org_id")
  status          String  @default("unofficial") // unofficial, claimed, verified, rejected

  // Tracking
  fetchCount    Int      @default(1) @map("fetch_count")
  useCount      Int      @default(0) @map("use_count") // How many times used in projects
  lastFetchedAt DateTime @default(now()) @map("last_fetched_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Raw AI response for debugging/reprocessing
  aiResponse           Json?  @map("ai_response")
  extractionConfidence String @default("medium") @map("extraction_confidence") // high, medium, low

  // Relations
  pairingsAsA    ProductPairing[]          @relation("PairingProductA")
  pairingsAsB    ProductPairing[]          @relation("PairingProductB")
  engagements    CachedProductEngagement[]
  selectionLinks SelectionCachedProduct[]
  stats          CachedProductStats?

  // Designer Fingerprint Relations
  designerAffinities  DesignerProductAffinity[]
  designerPairingsAsA DesignerPairing[]         @relation("DesignerPairingA")
  designerPairingsAsB DesignerPairing[]         @relation("DesignerPairingB")

  // Design Journey Relations
  presentationProducts PresentationProduct[]
  historyAsPrevious    SelectionHistory[]    @relation("HistoryPreviousProduct")
  historyAsNew         SelectionHistory[]    @relation("HistoryNewProduct")
  swapsFrom            SwapPattern[]         @relation("SwapFrom")
  swapsTo              SwapPattern[]         @relation("SwapTo")

  @@index([brand])
  @@index([vendorName])
  @@index([materialType])
  @@index([style])
  @@index([status])
  @@index([claimedOrgId])
  @@map("cached_products")
}

// Tracks which products are used together in projects
model ProductPairing {
  id String @id @default(uuid())

  // The two products (ordered: productAId < productBId)
  productAId String        @map("product_a_id")
  productA   CachedProduct @relation("PairingProductA", fields: [productAId], references: [id], onDelete: Cascade)
  productBId String        @map("product_b_id")
  productB   CachedProduct @relation("PairingProductB", fields: [productBId], references: [id], onDelete: Cascade)

  // Pairing context
  roomType String? @map("room_type") // kitchen, bathroom, living, bedroom, etc.

  // Strength metrics
  pairCount        Int @default(1) @map("pair_count") // How many times paired together
  sameProjectCount Int @default(0) @map("same_project_count") // In same project
  sameRoomCount    Int @default(0) @map("same_room_count") // In same room

  // Quality signals
  avgProjectLikes Decimal @default(0) @map("avg_project_likes") @db.Decimal(5, 2)
  avgProjectSaves Decimal @default(0) @map("avg_project_saves") @db.Decimal(5, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([productAId, productBId])
  @@index([productAId])
  @@index([productBId])
  @@index([roomType])
  @@map("product_pairings")
}

// Tracks user engagement with cached products
model CachedProductEngagement {
  id String @id @default(uuid())

  cachedProductId String        @map("cached_product_id")
  cachedProduct   CachedProduct @relation(fields: [cachedProductId], references: [id], onDelete: Cascade)

  userId String? @map("user_id")
  user   User?   @relation("CachedProductEngagements", fields: [userId], references: [id], onDelete: SetNull)

  engagementType String @map("engagement_type") // view, like, save, use, share, click_url

  // Context
  source    String? // import_modal, project_board, search, recommendation
  projectId String? @map("project_id")
  roomId    String? @map("room_id")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([cachedProductId])
  @@index([userId])
  @@index([engagementType])
  @@index([createdAt])
  @@map("cached_product_engagement")
}

// Links selections in projects to cached products
model SelectionCachedProduct {
  id String @id @default(uuid())

  selectionId String    @map("selection_id")
  selection   Selection @relation(fields: [selectionId], references: [id], onDelete: Cascade)

  cachedProductId String        @map("cached_product_id")
  cachedProduct   CachedProduct @relation(fields: [cachedProductId], references: [id], onDelete: Cascade)

  // How confident is this link
  matchConfidence Decimal @default(1.0) @map("match_confidence") @db.Decimal(3, 2) // 0.0 to 1.0
  matchMethod     String  @default("url") @map("match_method") // url, ai_match, manual

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([selectionId, cachedProductId])
  @@index([selectionId])
  @@index([cachedProductId])
  @@map("selection_cached_product")
}

// Aggregated stats for cached products (updated by background job)
model CachedProductStats {
  cachedProductId String        @id @map("cached_product_id")
  cachedProduct   CachedProduct @relation(fields: [cachedProductId], references: [id], onDelete: Cascade)

  // Usage stats
  totalUses       Int @default(0) @map("total_uses")
  uniqueProjects  Int @default(0) @map("unique_projects")
  uniqueDesigners Int @default(0) @map("unique_designers")

  // Engagement stats
  totalViews Int @default(0) @map("total_views")
  totalLikes Int @default(0) @map("total_likes")
  totalSaves Int @default(0) @map("total_saves")

  // Pairing stats
  totalPairings     Int  @default(0) @map("total_pairings")
  topPairedProducts Json @default("[]") @map("top_paired_products") // Array of {productId, count}

  // Quality score (computed)
  qualityScore  Decimal @default(0) @map("quality_score") @db.Decimal(5, 2) // 0-100
  trendingScore Decimal @default(0) @map("trending_score") @db.Decimal(5, 2) // Recent momentum

  // Time-based
  lastUsedAt DateTime? @map("last_used_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@map("cached_product_stats")
}

// Registry of brands seen, tracking claim status
model BrandRegistry {
  id String @id @default(uuid())

  // Brand identification
  name           String
  normalizedName String @unique @map("normalized_name") // lowercase, alphanumeric only

  // Known URLs
  websiteUrl        String?  @map("website_url")
  knownRetailerUrls String[] @default([]) @map("known_retailer_urls") // URLs where this brand is sold

  // Claimed status
  claimedOrgId String?   @map("claimed_org_id")
  claimedAt    DateTime? @map("claimed_at")

  // Stats
  productCount Int @default(0) @map("product_count")
  totalUses    Int @default(0) @map("total_uses")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([normalizedName])
  @@index([claimedOrgId])
  @@map("brand_registry")
}

// =====================================================
// Designer Fingerprint Tracking
// =====================================================

// Tracks individual designer affinity for products, brands, materials, and styles
model DesignerProductAffinity {
  id String @id @default(uuid())

  designerId String @map("designer_id")
  designer   User   @relation(fields: [designerId], references: [id], onDelete: Cascade)

  // What they're affiliated with (one of these will be set)
  cachedProductId String?        @map("cached_product_id")
  cachedProduct   CachedProduct? @relation(fields: [cachedProductId], references: [id], onDelete: Cascade)
  brandName       String?        @map("brand_name") // Normalized brand name
  materialType    String?        @map("material_type") // stone, tile, wood, etc.
  style           String? // modern, traditional, etc.

  // Affinity metrics
  useCount     Int      @default(1) @map("use_count")
  projectCount Int      @default(1) @map("project_count")
  firstUsedAt  DateTime @default(now()) @map("first_used_at")
  lastUsedAt   DateTime @default(now()) @map("last_used_at")

  // Engagement signals
  totalLikesReceived Int @default(0) @map("total_likes_received")
  totalSavesReceived Int @default(0) @map("total_saves_received")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([designerId])
  @@index([cachedProductId])
  @@index([brandName])
  @@index([materialType])
  @@index([style])
  @@index([useCount(sort: Desc)])
  @@map("designer_product_affinity")
}

// Tracks what products each designer pairs together (vs aggregate)
model DesignerPairing {
  id String @id @default(uuid())

  designerId String @map("designer_id")
  designer   User   @relation(fields: [designerId], references: [id], onDelete: Cascade)

  // The two products (ordered: product_a_id < product_b_id)
  productAId String        @map("product_a_id")
  productA   CachedProduct @relation("DesignerPairingA", fields: [productAId], references: [id], onDelete: Cascade)
  productBId String        @map("product_b_id")
  productB   CachedProduct @relation("DesignerPairingB", fields: [productBId], references: [id], onDelete: Cascade)

  // Context
  roomType String? @map("room_type")

  // Pairing strength for THIS designer
  pairCount     Int @default(1) @map("pair_count")
  sameRoomCount Int @default(0) @map("same_room_count")

  // Quality signals
  avgLikes Decimal? @default(0) @map("avg_likes") @db.Decimal(5, 2)
  avgSaves Decimal? @default(0) @map("avg_saves") @db.Decimal(5, 2)

  firstPairedAt DateTime @default(now()) @map("first_paired_at")
  lastPairedAt  DateTime @default(now()) @map("last_paired_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([designerId, productAId, productBId])
  @@index([designerId])
  @@index([productAId])
  @@index([productBId])
  @@index([roomType])
  @@index([pairCount(sort: Desc)])
  @@map("designer_pairings")
}

// Aggregated style fingerprint for each designer
model DesignerStyleProfile {
  designerId String @id @map("designer_id")
  designer   User   @relation(fields: [designerId], references: [id], onDelete: Cascade)

  // Material preferences (percentages)
  materialBreakdown Json @default("{}") @map("material_breakdown")

  // Style preferences
  styleBreakdown Json @default("{}") @map("style_breakdown")

  // Price tier preferences
  priceTierBreakdown Json @default("{}") @map("price_tier_breakdown")

  // Top brands (ordered by usage)
  topBrands Json @default("[]") @map("top_brands")

  // Room type preferences
  roomTypeBreakdown Json @default("{}") @map("room_type_breakdown")

  // Signature pairings (what they uniquely use together vs aggregate)
  signaturePairings Json @default("[]") @map("signature_pairings")

  // Delta from aggregate (how different from average designer)
  aggregateDeltaScore Decimal @default(0) @map("aggregate_delta_score") @db.Decimal(5, 2)

  // Stats
  totalProductsUsed Int @default(0) @map("total_products_used")
  totalProjects     Int @default(0) @map("total_projects")
  totalSelections   Int @default(0) @map("total_selections")

  // Quality metrics
  avgProjectLikes Decimal @default(0) @map("avg_project_likes") @db.Decimal(5, 2)
  avgProjectSaves Decimal @default(0) @map("avg_project_saves") @db.Decimal(5, 2)

  // Timestamps
  profileComputedAt DateTime @default(now()) @map("profile_computed_at")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("designer_style_profile")
}

// =====================================================
// Design Journey Tracking
// =====================================================

// Products extracted from original presentations
model PresentationProduct {
  id String @id @default(uuid())

  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Link to cached product once matched
  cachedProductId String?        @map("cached_product_id")
  cachedProduct   CachedProduct? @relation(fields: [cachedProductId], references: [id], onDelete: SetNull)

  // Extracted data
  extractedName     String?  @map("extracted_name")
  extractedBrand    String?  @map("extracted_brand")
  extractedImageUrl String?  @map("extracted_image_url")
  extractedUrl      String?  @map("extracted_url")
  extractedPrice    Decimal? @map("extracted_price") @db.Decimal(10, 2)

  // Role/placement
  suggestedRole String? @map("suggested_role")
  suggestedRoom String? @map("suggested_room")

  // Source context
  slideNumber   Int?    @map("slide_number")
  pageNumber    Int?    @map("page_number")
  sourceFileUrl String? @map("source_file_url")
  sourceType    String? @map("source_type") // pdf, pptx, figma, image, url_list

  // Matching
  matchStatus     String   @default("unmatched") @map("match_status")
  matchConfidence Decimal? @map("match_confidence") @db.Decimal(3, 2)

  // Outcome
  keptInFinal      Boolean?   @map("kept_in_final")
  finalSelectionId String?    @map("final_selection_id")
  finalSelection   Selection? @relation(fields: [finalSelectionId], references: [id], onDelete: SetNull)

  extractedAt DateTime @default(now()) @map("extracted_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([projectId])
  @@index([cachedProductId])
  @@index([matchStatus])
  @@map("presentation_products")
}

// Original design intent/vision for a project
model ProjectDesignIntent {
  id String @id @default(uuid())

  projectId String  @unique @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Style goals
  styleGoals          String[] @default([]) @map("style_goals")
  materialPreferences String[] @default([]) @map("material_preferences")
  colorPalette        Json     @default("[]") @map("color_palette")

  // Budget
  budgetTier  String? @map("budget_tier")
  budgetNotes String? @map("budget_notes")

  // Priorities
  priorityRooms String[] @default([]) @map("priority_rooms")

  // Presentation source
  presentationFileUrl      String?   @map("presentation_file_url")
  presentationParsedAt     DateTime? @map("presentation_parsed_at")
  presentationProductCount Int       @default(0) @map("presentation_product_count")

  // Mood/inspiration
  moodKeywords    String[] @default([]) @map("mood_keywords")
  inspirationUrls String[] @default([]) @map("inspiration_urls")
  clientNotes     String?  @map("client_notes")

  // AI-detected
  aiDetectedStyle String? @map("ai_detected_style")
  aiDetectedMood  Json?   @map("ai_detected_mood")
  aiConfidence    String? @map("ai_confidence")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("project_design_intent")
}

// Changelog for selection changes
model SelectionHistory {
  id String @id @default(uuid())

  selectionId String?    @map("selection_id")
  selection   Selection? @relation(fields: [selectionId], references: [id], onDelete: SetNull)

  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  roomId  String? @map("room_id")
  slotKey String? @map("slot_key")

  // Action
  action String // created, updated, deleted, swapped, restored

  // Who
  changedByUserId String? @map("changed_by_user_id")
  changedByUser   User?   @relation(fields: [changedByUserId], references: [id], onDelete: SetNull)
  changedByRole   String? @map("changed_by_role") // designer, client, collaborator, system

  // Products before/after
  previousProductId String?        @map("previous_cached_product_id")
  previousProduct   CachedProduct? @relation("HistoryPreviousProduct", fields: [previousProductId], references: [id], onDelete: SetNull)
  newProductId      String?        @map("new_cached_product_id")
  newProduct        CachedProduct? @relation("HistoryNewProduct", fields: [newProductId], references: [id], onDelete: SetNull)

  // What changed
  changedFields Json? @map("changed_fields")

  // Why
  reasonCategory String? @map("reason_category") // budget, availability, client_preference, design_change, substitution
  reasonNotes    String? @map("reason_notes")

  // Context
  source String? // designer_board, import, presentation, client_portal, ai_suggestion

  // Snapshot
  selectionSnapshot Json? @map("selection_snapshot")

  changedAt DateTime @default(now()) @map("changed_at")

  @@index([selectionId])
  @@index([projectId])
  @@index([changedByUserId])
  @@index([action])
  @@index([reasonCategory])
  @@index([changedAt(sort: Desc)])
  @@map("selection_history")
}

// Aggregated journey summary for a project
model ProjectDesignJourney {
  projectId String  @id @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Counts
  presentationProductCount Int @default(0) @map("presentation_product_count")
  finalSelectionCount      Int @default(0) @map("final_selection_count")

  // Product journey
  productsKept    Int @default(0) @map("products_kept")
  productsSwapped Int @default(0) @map("products_swapped")
  productsAdded   Int @default(0) @map("products_added")
  productsRemoved Int @default(0) @map("products_removed")

  // Attribution
  totalChanges          Int @default(0) @map("total_changes")
  changesByDesigner     Int @default(0) @map("changes_by_designer")
  changesByClient       Int @default(0) @map("changes_by_client")
  changesByCollaborator Int @default(0) @map("changes_by_collaborator")
  changesBySystem       Int @default(0) @map("changes_by_system")

  // Reasons
  changesForBudget           Int @default(0) @map("changes_for_budget")
  changesForAvailability     Int @default(0) @map("changes_for_availability")
  changesForClientPreference Int @default(0) @map("changes_for_client_preference")
  changesForDesignChange     Int @default(0) @map("changes_for_design_change")
  changesForSubstitution     Int @default(0) @map("changes_for_substitution")
  changesForOther            Int @default(0) @map("changes_for_other")

  // Style analysis
  originalStyleTags     Json     @default("[]") @map("original_style_tags")
  finalStyleTags        Json     @default("[]") @map("final_style_tags")
  styleConsistencyScore Decimal? @map("style_consistency_score") @db.Decimal(5, 2)
  styleDriftNotes       String?  @map("style_drift_notes")

  // Timeline
  firstChangeAt    DateTime? @map("first_change_at")
  lastChangeAt     DateTime? @map("last_change_at")
  avgChangesPerDay Decimal?  @map("avg_changes_per_day") @db.Decimal(5, 2)

  // Insights
  budgetImpactPercent  Decimal? @map("budget_impact_percent") @db.Decimal(5, 2)
  clientInfluenceScore Decimal? @map("client_influence_score") @db.Decimal(5, 2)

  computedAt DateTime @default(now()) @map("computed_at")

  @@map("project_design_journey")
}

// Common product substitution patterns
model SwapPattern {
  id String @id @default(uuid())

  // Product-level swap
  fromProductId String?        @map("from_product_id")
  fromProduct   CachedProduct? @relation("SwapFrom", fields: [fromProductId], references: [id], onDelete: Cascade)
  toProductId   String?        @map("to_product_id")
  toProduct     CachedProduct? @relation("SwapTo", fields: [toProductId], references: [id], onDelete: Cascade)

  // Brand-level swap
  fromBrand String? @map("from_brand")
  toBrand   String? @map("to_brand")

  // Context
  materialType String? @map("material_type")
  role         String?

  // Frequency
  swapCount Int @default(1) @map("swap_count")

  // Reasons
  commonReasons Json @default("[]") @map("common_reasons")

  // Quality
  avgProjectSatisfaction Decimal? @map("avg_project_satisfaction") @db.Decimal(3, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([fromProductId, toProductId])
  @@index([fromProductId])
  @@index([toProductId])
  @@index([fromBrand])
  @@index([swapCount(sort: Desc)])
  @@map("swap_patterns")
}

// ============================================
// REAL-TIME INTERVIEW MODELS
// ============================================

enum RealtimeSessionStatus {
  ACTIVE
  PAUSED
  COMPLETED
  ABANDONED
  FAILED
}

model RealtimeInterviewSession {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Link to editorial interview for provenance
  editorialInterviewId String?
  editorialInterview   EditorialInterview? @relation(fields: [editorialInterviewId], references: [id])

  // Session state
  status          RealtimeSessionStatus @default(ACTIVE)
  startedAt       DateTime              @default(now())
  endedAt         DateTime?
  totalDurationMs Int?

  // Context snapshot (loaded at session start)
  projectContext Json? // { images[], products[], rooms[], designerName }

  // Running conversation management
  conversationSummary String? @db.Text // AI-maintained summary
  turnCount           Int     @default(0)

  // Accumulated extractions
  extractedQuotes    Json? // [{ text, timestamp, confidence, context }]
  extractedProducts  Json? // [{ name, context, sentiment, timestamp }]
  extractedThemes    Json? // [{ theme, frequency, quotes[] }]
  extractedDecisions Json? // [{ decision, reasoning, room? }]

  // LiveKit metadata
  livekitRoomName String? @unique
  livekitRoomId   String?

  // Quality metrics
  avgTranscriptConfidence Float?
  designerSpeakingRatio   Float? // % of time designer vs AI spoke

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  segments RealtimeConversationSegment[]

  @@index([projectId])
  @@index([status])
  @@map("realtime_interview_sessions")
}

model RealtimeConversationSegment {
  id        String                   @id @default(cuid())
  sessionId String
  session   RealtimeInterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  // Sequence
  sequenceNumber Int

  // Who spoke
  role String // 'designer' | 'ai'

  // Content
  content  String  @db.Text
  audioUrl String? // S3/Supabase URL if retained

  // Timing
  startedAt  DateTime
  endedAt    DateTime?
  durationMs Int?

  // For designer segments: transcription metadata
  transcriptConfidence Float?
  transcriptRaw        String? @db.Text // Before any cleanup

  // For AI segments: generation metadata
  promptTokens   Int?
  responseTokens Int?
  latencyMs      Int? // Time from designer stop → AI audio start

  // Real-time extractions from this segment
  extractedQuote    String?  @db.Text
  extractedProducts String[]
  extractedMood     String? // 'excited', 'reflective', 'uncertain', etc.

  // Contextual linking
  linkedQuestionId String? // If responding to a specific question
  linkedImageIds   String[] // Images referenced in this segment
  linkedProductIds String[] // Products referenced in this segment
  linkedRoomName   String? // Room being discussed

  createdAt DateTime @default(now())

  @@unique([sessionId, sequenceNumber])
  @@index([sessionId, startedAt])
  @@map("realtime_conversation_segments")
}

// Instagram Export System (single carousel export)
