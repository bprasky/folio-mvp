generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                             String                @id @default(uuid())
  email                          String                @unique
  name                           String
  bio                            String?
  profileImage                   String?
  location                       String?
  title                          String?
  phone                          String?
  studio                         String?
  specialties                    String[]
  website                        String?
  instagram                      String?
  linkedin                       String?
  companyName                    String?
  budgetRange                    String?
  desiredRooms                   String[]
  serviceLevel                   String?
  projectStatus                  String?
  followers                      Int                   @default(0)
  following                      Int                   @default(0)
  views                          Int                   @default(0)
  createdAt                      DateTime              @default(now())
  updatedAt                      DateTime              @updatedAt
  role                           Role                  @default(INDIVIDUAL)
  passwordHash                   String
  // Account approval system
  accountStatus                  AccountStatus         @default(APPROVED)
  approvedAt                     DateTime?
  approvedBy                     String?
  rejectionReason                String?
  applicationNote                String?
  onboardingCompletedAt          DateTime?
  // Designer onboarding tracking
  onboardingBrandStepCompletedAt DateTime?
  // Brand profile relation (for designers)
  brandProfile                   DesignerBrandProfile?
  // Aesthetic detection
  aestheticProfile               Json?     // Stores AestheticProfile
  aestheticDetectedAt            DateTime?
  profileState                   String    @default("empty") // ProfileState enum as string
  brandAssets                    DesignerBrandAssets?
  engagementEvents               EngagementEvent[]
  rsvps                          EventRSVP[]           @relation("UserRSVPs")
  events                         Event[]               @relation("EventCreator")
  folders                        Folder[]
  organizationUsers              OrganizationUser[]
  posts                          posts[]
  products                       Product[]             @relation("VendorProducts")
  designerProjects               Project[]             @relation("DesignerProjects")
  ownedProjects                  Project[]             @relation("OwnedProjects")
  vendorQuotes                   Quote[]               @relation("VendorQuotes")
  vendorSelections               Selection[]           @relation("VendorSelections")
  stories                        Story[]
  vendorStories                  Story[]               @relation("StoryToVendor")
  projectParticipants            ProjectParticipant[]
  projectModules                 ProjectModule[]
  // Removed - AttributeVerification doesn't have designerId field
  designerDecisions              DesignerDecision[]
  voiceProfile                   DesignerVoiceProfile?
  reasoningProfile               DesignerReasoningProfile?
  // Impersonation relations
  adminImpersonations            ImpersonationLog[]    @relation("AdminImpersonations")
  userImpersonations             ImpersonationLog[]    @relation("UserImpersonations")
  // Collaboration stories (as designer)
  collaborationStories           CollaborationStory[]  @relation("CollaborationStoryDesigner")
  // Phase 2: Org join requests
  orgJoinRequests                OrgJoinRequest[]

  // Workspace context: null = operating as individual, orgId = operating as that org
  operatingAsOrgId               String?
  operatingAsOrg                 Organization?         @relation("UserOperatingAs", fields: [operatingAsOrgId], references: [id])

  // Presale consultation relations
  buyerConsultations             Consultation[]        @relation("BuyerConsultations")
  designerConsultations          Consultation[]        @relation("DesignerConsultations")
  developmentDesigners           DevelopmentDesigner[]
  consultationBuyer              ConsultationBuyer?

  // Boost system relations
  boostOpportunities             BoostOpportunity[]    @relation("DesignerBoostOpportunities")
  approvedBoosts                 Boost[]               @relation("UserBoosts")
  notifications                  Notification[]

  // Architect-specific profile fields
  architectLicenseNumber         String?               // Professional license number
  architectLicensedStates        String[]              // e.g., ["CA", "NY", "TX"]
  architectProjectScale          String[]              // e.g., ["residential", "commercial", "institutional"]
  architectSpecializations       String[]              // e.g., ["adaptive_reuse", "ground_up", "historic_preservation"]

  // Builder-specific profile fields
  builderProjectTypes            String[]              // e.g., ["custom_homes", "renovations", "commercial_ti"]
  builderSquareFootageRange      String?               // e.g., "5000-25000" or "25000+"
  builderSpecialtyTrades         String[]              // e.g., ["millwork", "steel", "concrete", "glass"]
  builderYearsInBusiness         Int?

  // Commerce & Credit relations
  creditAccount                  CreditAccount?
  purchaserOrders                Order[]               @relation("PurchaserOrders")
  attributedDesignerOrders       Order[]               @relation("AttributedDesignerOrders")
  attributedRepOrders            Order[]               @relation("AttributedRepOrders")

  // Directory & Subscription
  subscriptionTier               SubscriptionTier      @default(FREE)
  subscriptionExpiresAt          DateTime?             // null = lifetime (founding designers)
  showRankInBio                  Boolean               @default(true)
  directoryRanking               DirectoryRanking?

  // Profile System relations
  media                          Media[]
  recognition                    Recognition[]
  collaborations                 Collaboration[]
  collaborationPartner           Collaboration[]       @relation("CollaborationPartner")
  profileInterview               ProfileInterview?
  teamMemberships                TeamMember[]

  // Team member invites
  invitedTeamMembers             TeamMemberInvite[]   @relation("InvitedTeamMembers")
  claimedInvites                 TeamMemberInvite[]   @relation("ClaimedInvites")

  // Legal consent tracking
  tosAcceptedAt                  DateTime?
  privacyAcceptedAt              DateTime?
  tosVersion                     String?               // e.g., "2026-01-19"
  privacyVersion                 String?               // e.g., "2026-01-19"

  // Designer Attribution & Compensation System
  vendorVisibility               Boolean               @default(false) // Whether vendors can see designer's active specifications
  vendorVisibilityEnabledAt      DateTime?             // When visibility was turned on
  influenceScore                 Float?                // Calculated influence score 0-100
  influenceScoreUpdatedAt        DateTime?             // Last score calculation
  folioCreditBalance             Decimal               @default(0) @db.Decimal(10, 2) // Current Folio Credit balance in USD

  // Product search and rep contact relations
  productSearchLogs              ProductSearchLog[]
  vendorRepContacts              VendorRepContact[]

  // Intelligence System relations
  likes                          Like[]                @relation("UserLikes")
  saves                          Save[]                @relation("UserSaves")
  boards                         Board[]               @relation("UserBoards")
  tasteInferences                TasteInference[]      @relation("UserTasteInferences")
  tasteProfile                   UserTasteProfile?     @relation("UserTasteProfile")
  trendInterviewRequests         TrendInterviewRequest[] @relation("DesignerTrendInterviews")

  // Contributor/Voice System relations
  contributions                  Contribution[]        @relation("UserContributions")
  contributorBadges              ContributorBadge[]    @relation("UserContributorBadges")
  contributionCount              Int                   @default(0)
  publishedContributionCount     Int                   @default(0)
  contributorLevel               BadgeLevel?

  // Designer Shop System relations
  shopProducts                   ShopProduct[]         @relation("DesignerShopProducts")

  // Vendor Invite & Presentation System
  vendorInvitesClaimed           VendorInvite[]        @relation("VendorInvitesClaimed")
  vendorInvitesAdmin             VendorInvite[]        @relation("VendorInvitesAdmin")
  vendorPresentationViews        VendorPresentationView[] @relation("VendorPresentationViews")

  @@map("users")
}

model Event {
  id                       String             @id @default(cuid())
  title                    String
  description              String
  location                 String
  // Location fields (from database)
  city                     String?
  state                    String?
  country                  String?
  startDate                DateTime
  endDate                  DateTime
  isPublic                 Boolean            @default(true)
  isApproved               Boolean?           @default(false)
  requiresApproval         Boolean            @default(false)
  rejectionNotes           String?
  createdById              String
  parentFestivalId         String?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  imageUrl                 String?
  allowChat                Boolean            @default(false)
  allowReshare             Boolean            @default(true)
  capacity                 Int?
  chatGroupLink            String?
  createdByReputationScore Float?
  designStyles             String[]           @default([])
  displayBoostUntil        DateTime?
  eventHashtag             String?
  eventTags                String[]           @default([])
  eventTypes               EventType[]
  includesFood             Boolean            @default(false)
  inviteType               String             @default("open")
  isSponsored              Boolean            @default(false)
  isVirtual                Boolean            @default(false)
  linkedProducts           String[]           @default([])
  mapLink                  String?
  mediaGallery             String[]           @default([])
  postEventMessage         String?
  promotionTier            Int                @default(0)
  rsvpDeadline             DateTime?
  targetUserRoles          String[]           @default([])
  timezone                 String?
  waitlistEnabled          Boolean            @default(false)
  isFestival               Boolean            @default(false)
  bookings                 bookings[]
  clicks                   clicks[]
  engagementEvents         EngagementEvent[]
  event_metrics            event_metrics?
  productStats             EventProductStat[]
  event_products           event_products[]
  rsvps                    EventRSVP[]
  createdBy                User               @relation("EventCreator", fields: [createdById], references: [id])
  parentFestival           Event?             @relation("FestivalSubevents", fields: [parentFestivalId], references: [id])
  subevents                Event[]            @relation("FestivalSubevents")
  impressions              impressions[]
  placements               placements[]

  @@index([parentFestivalId])
  @@index([city])
  @@index([startDate])
  @@map("events")
}

model EventRSVP {
  id        String   @id @default(cuid())
  status    String   @default("attending")
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User     @relation("UserRSVPs", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@map("event_rsvps")
}

model Project {
  id                   String                @id @default(uuid())
  description          String?
  category             String?
  status               String                @default("active")
  stage                ProjectStage          @default(concept)
  isPublic             Boolean               @default(false)
  publishedAt          DateTime?
  isAIEnabled          Boolean               @default(false)
  views                Int                   @default(0)
  saves                Int                   @default(0)
  shares               Int                   @default(0)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  designerId           String?
  ownerId              String
  vendorOrgId          String?
  designerOrgId        String?
  isHandoffReady       Boolean               @default(false)
  handoffInvitedAt     DateTime?
  handoffClaimedAt     DateTime?
  title                String                @default("")
  projectType          ProjectType           @default(UNSPECIFIED)
  clientType           ClientType            @default(RESIDENTIAL)
  budgetBand           BudgetBand            @default(UNSPECIFIED)
  city                 String?
  regionState          String?
  files                ProjectFile[]
  images               ProjectImage[]
  designer             User?                 @relation("DesignerProjects", fields: [designerId], references: [id])
  designerOrg          Organization?         @relation("DesignerProjects", fields: [designerOrgId], references: [id])
  owner                User                  @relation("OwnedProjects", fields: [ownerId], references: [id])
  vendorOrg            Organization?         @relation("VendorProjects", fields: [vendorOrgId], references: [id])
  quotes               Quote[]
  rooms                Room[]
  selections           Selection[]
  stories              Story[]
  participants         ProjectParticipant[]
  post                 ProjectPost?
  editorialAssignments EditorialAssignment[]
  editorialInterviews  EditorialInterview[]
  modules              ProjectModule[]
  attributeVerifications AttributeVerification[] @relation("ProjectAttributeVerifications")
  designerDecisions    DesignerDecision[]
  instagramCampaigns   InstagramCampaign[]

  // Commerce relations
  orders               Order[]

  // Profile System relations
  media                Media[]
  recognition          Recognition[]
  collaborations       Collaboration[]

  // Pinning for profile feed
  pinnedAt             DateTime?
  pinOrder             Int?

  // PDF Extraction relations
  pdfExtractions       PdfExtraction[]
  skeletonItems        SkeletonItem[]

  // Boost system relations
  boostOpportunities   BoostOpportunity[]

  // Intelligence System relations
  trendInterviewRequests TrendInterviewRequest[] @relation("ProjectTrendInterviews")

  // Contributor/Voice System relations
  contributions          Contribution[]          @relation("ProjectContributions")

  // Designer Shop System relations
  shopProducts           ShopProduct[]           @relation("ProjectShopProducts")

  @@map("projects")
}

model ProjectImage {
  id           String       @id @default(uuid())
  url          String
  name         String?
  room         String?
  displayOrder Int?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  projectId    String
  tags         ProductTag[]
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  // Search indexing fields
  searchVector      String?   // Full-text search vector
  aiTags            String[]  @default([]) // AI-detected objects, materials, colors
  aiColors          Json?     // Dominant color palette extracted
  aiMaterials       String[]  @default([]) // AI-detected materials (marble, brass, wood, etc.)
  aiSpaces          String[]  @default([]) // AI-detected space types (kitchen, bathroom, pool, etc.)
  indexedAt         DateTime? // Last indexing timestamp
  
  // AI classification for interview questions
  aiClassification  Json?     @map("ai_classification") // Stores full ImageClassification result
  aiClassifiedAt    DateTime? @map("ai_classified_at") // When classification ran
  verifiedAttributes Json?    @map("verified_attributes") // Designer-confirmed attributes
  verifiedAt        DateTime? @map("verified_at") // When attributes were verified
  
  // Engagement (for ranking)
  momentViews       Int       @default(0)
  momentSaves       Int       @default(0)
  momentShares      Int       @default(0)
  
  // Relation to search index
  momentIndex       MomentIndex?
  
  // Relation to attribute verifications
  attributeVerifications AttributeVerification[] @relation("ImageAttributeVerifications")
  designerDecisions      DesignerDecision[]

  @@map("project_images")
}

model MomentIndex {
  id              String   @id @default(cuid())
  projectImageId  String   @unique
  projectImage    ProjectImage @relation(fields: [projectImageId], references: [id], onDelete: Cascade)
  
  // Denormalized for fast search
  projectId       String
  designerId      String
  designerName    String
  projectTitle    String
  isPublic        Boolean  // From parent project
  publishedAt     DateTime?
  
  // Search fields
  combinedTags    String[] @default([]) // Merge of explicit tags + AI tags
  searchText      String   @default("") // Concatenated searchable text
  
  // NEW: Dedicated searchable fields
  room            String?           // e.g., "living room", "kitchen", "bathroom"
  roomNormalized  String?           // Lowercase, no spaces: "livingroom" for fuzzy matching
  vendors         String[]          @default([]) // Array of vendor names from tagged products
  vendorIds       String[]          @default([]) // Array of vendor IDs for exact filtering
  categories      String[]          @default([]) // e.g., ["furniture", "lighting", "textiles"]
  colors          String[]          @default([]) // e.g., ["white", "oak", "brass", "marble"]
  materials       String[]          @default([]) // e.g., ["wood", "stone", "metal", "fabric"]
  styles          String[]          @default([]) // e.g., ["modern", "coastal", "mediterranean"]
  mood            String[]          @default([]) // e.g., ["airy", "moody", "warm", "dramatic"]
  elements        String[]          @default([]) // e.g., ["pendant lighting", "kitchen island", "built-ins"]
  
  // Scoring
  engagementScore Float    @default(0)
  editorialScore  Float    @default(0)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([isPublic, publishedAt])
  @@index([designerId])
  @@index([combinedTags])
  @@index([room])
  @@index([roomNormalized])
  @@index([vendors])
  @@index([vendorIds])
  @@index([categories])
  @@index([colors])
  @@index([materials])
  @@index([styles])
  @@index([mood])
  @@index([elements])
  @@index([room, vendors])
  @@map("moment_index")
}

model Product {
  id               String             @id @default(uuid())
  name             String
  description      String?
  price            Float?
  imageUrl         String?
  cutoutImageUrl   String?
  category         String?
  brand            String?
  url              String?
  isPending        Boolean            @default(false)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  vendorId         String?
  engagementEvents EngagementEvent[]
  productStats     EventProductStat[]
  folderProducts   FolderProduct[]
  tags             ProductTag[]
  vendor           User?              @relation("VendorProducts", fields: [vendorId], references: [id])

  // Commerce relations
  orderItems       OrderItem[]

  // Presale development catalog relations
  developmentProducts DevelopmentProduct[]

  // PDF Extraction - skeleton items confirmed as this product
  skeletonItems       SkeletonItem[]

  // Intelligence System relations
  likes               Like[]                      @relation("ProductLikes")
  savesReceived       Save[]                      @relation("ProductSaves")
  contentOpportunities VendorContentOpportunity[] @relation("ProductContentOpportunities")

  // Contributor/Voice System relations
  contributions       Contribution[]              @relation("ProductContributions")

  // Designer Shop System relations
  shopProducts        ShopProduct[]               @relation("ProductShopProducts")
  testimonials        ProductTestimonial[]        @relation("ProductTestimonials")

  @@map("products")
}

model ProductTag {
  id        String       @id @default(uuid())
  x         Float
  y         Float
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  productId String
  imageId   String
  image     ProjectImage @relation(fields: [imageId], references: [id], onDelete: Cascade)
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  selection Selection?   // Selection created from this tag

  // Intelligence System relations
  supplementalQuotes SupplementalQuote[] @relation("ProductTagQuotes")

  // Vendor Invite System
  vendorInviteTriggers VendorInvite[] @relation("VendorInviteTriggerTag")

  @@map("product_tags")
}

model Folder {
  id         String          @id @default(uuid())
  name       String
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  designerId String
  products   FolderProduct[]
  designer   User            @relation(fields: [designerId], references: [id])
  posts      posts[]

  @@map("folders")
}

model FolderProduct {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  folderId  String
  productId String
  folder    Folder   @relation(fields: [folderId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([folderId, productId])
  @@map("folder_products")
}

model Story {
  id           String     @id @default(uuid())
  videoUrl     String
  thumbnailUrl String?
  duration     Int
  createdAt    DateTime   @default(now())
  expiresAt    DateTime?
  isPinned     Boolean    @default(false)
  views        Int        @default(0)
  likes        Int        @default(0)
  designerId   String
  projectId    String?
  designer     User       @relation(fields: [designerId], references: [id])
  project      Project?   @relation(fields: [projectId], references: [id])
  categories   Category[] @relation("StoryToCategory")
  vendors      User[]     @relation("StoryToVendor")

  @@map("stories")
}

model Category {
  id      String  @id @default(uuid())
  name    String  @unique
  stories Story[] @relation("StoryToCategory")

  @@map("categories")
}

model Room {
  id            String         @id @default(uuid())
  name          String
  type          String? // Optional room type: KITCHEN, BATH, LIVING, BEDROOM, DINING, OFFICE, ENTRY
  projectId     String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  quotes        Quote[]
  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  selections    Selection[]
  skeletonItems SkeletonItem[]

  @@map("rooms")
}

model Selection {
  id                String   @id @default(uuid())
  photo             String?
  vendorName        String?
  productName       String?
  colorFinish       String?
  notes             String?
  phaseOfUse        String?
  gpsLocation       String?
  source            String   @default("upload")
  timestamp         DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  roomId            String?
  projectId         String
  quantity          Int?
  specSheetFileName String?
  specSheetUrl      String?
  unitPrice         Decimal? @db.Decimal(10, 2)
  vendorProductId   String?
  vendorRepId       String?
  productUrl        String?
  tags              String[] @default([])
  slotKey           String? // Optional slot key for room template tracking (e.g., 'countertop', 'sofa')
  uiMeta            Json? // UI metadata: displaySize, featured, dimensions, etc.
  productTagId      String?  @unique // Link back to source ProductTag
  quotes            Quote[]
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  room              Room?    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  vendorRep         User?    @relation("VendorSelections", fields: [vendorRepId], references: [id])
  productTag        ProductTag? @relation(fields: [productTagId], references: [id], onDelete: SetNull)

  @@map("selections")
}

model ProjectFile {
  id           String   @id @default(uuid())
  fileName     String
  fileType     String
  fileUrl      String
  uploadedBy   String
  dateUploaded DateTime @default(now())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_files")
}

model Organization {
  id                  String               @id @default(uuid())
  name                String
  type                OrgType              @default(DESIGN_FIRM)
  description         String?
  website             String?
  logo                String?
  vendorTier          VendorTier?          // Subscription tier for vendor organizations
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  // Profile fields
  tagline             String?
  philosophy          String?              @db.Text
  location            String?
  foundedYear         Int?
  specialties         String[]
  followerCount       Int                  @default(0)

  // Studio details (structured)
  teamSizeRange       TeamSizeRange?
  services            String[]             // Full-service, Consultation, E-design
  projectTypes        String[]             // Residential, Commercial, Hospitality
  serviceRegions      String[]             // Geographic service areas
  memberships         String[]             // ASID, AIA, NKBA
  certifications      String[]             // LEED, WELL, Passive House

  // Phase 2: Organization tier and verification
  status              OrgStatus            @default(UNCLAIMED)
  address             String?              // Required for creation in Phase 2
  phone               String?              // Required for creation in Phase 2

  // Verification fields (populated during claim/upgrade)
  businessLicense     String?              // URL to uploaded license
  bankAccountInfo     Json?                // Encrypted payout info for Professional tier
  verifiedAt          DateTime?
  verifiedBy          String?              // Admin user ID who verified

  // Sales tracking (for outreach to unclaimed orgs)
  createdById         String?              // User who created the org
  salesNotes          String?
  salesContactedAt    DateTime?

  // Relations
  users               OrganizationUser[]
  designerProjects    Project[]            @relation("DesignerProjects")
  vendorProjects      Project[]            @relation("VendorProjects")
  projectParticipants ProjectParticipant[]
  collaborationStories CollaborationStory[] @relation("CollaborationStoryVendor")
  joinRequests        OrgJoinRequest[]
  usersOperatingAs    User[]               @relation("UserOperatingAs")

  // Commerce & Credit relations
  vendorOrders        Order[]              @relation("VendorOrders")
  tradeAccounts       VendorTradeAccount[]

  // Directory ranking for vendor organizations
  directoryRanking    DirectoryRanking?    @relation("DirectoryRanking")

  // Vendor subscription (for vendor organizations)
  vendorSubscription  VendorSubscription?

  // Boost system relations
  boostOpportunities  BoostOpportunity[]   @relation("VendorBoostOpportunities")
  boosts              Boost[]              @relation("VendorBoosts")

  // Profile System relations
  teamMembers         TeamMember[]
  collaborations      Collaboration[]
  orgMedia            OrgMedia[]
  orgRecognition      OrgRecognition[]
  orgCollaborations   OrgCollaboration[]

  // Organization onboarding relations
  onboardingProgress   OrgOnboardingProgress?
  bioInterview         OrgBioInterview?
  teamMemberInvites    TeamMemberInvite[]
  processPhases        OrgProcessPhase[]
  vendorPartnerships   OrgVendorPartnership[] @relation("DesignFirmPartnerships")
  inboundPartnerships  OrgVendorPartnership[] @relation("VendorPartnerships")

  // Presale development relations (for DEVELOPER orgs)
  developments        Development[]

  // Intelligence System relations
  contentOpportunities VendorContentOpportunity[] @relation("VendorContentOpportunities")

  // Designer Shop System relations
  shopBoosts           ShopBoost[]               @relation("VendorShopBoosts")

  // Vendor Invite & Presentation System
  vendorInvite             VendorInvite?
  presentationViews        VendorPresentationView[]
  isFoundingVendor         Boolean   @default(false)
  foundingVendorClaimedAt  DateTime?

  @@index([status])
  @@index([type])
  @@index([createdById])
  @@map("organizations")
}

model OrganizationUser {
  id             String       @id @default(uuid())
  userId         String
  organizationId String
  role           OrgUserRole  @default(MEMBER)
  isActive       Boolean      @default(true)
  joinedAt       DateTime     @default(now())
  workEmail      String?      // Work email associated with this org membership

  // Phase 2: Display preferences
  showOnProfile  Boolean      @default(true)  // Whether to show this org on user's profile

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Team member quiz for onboarding
  teamMemberQuiz TeamMemberQuiz?

  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
  @@map("organization_users")
}

// Phase 2: Join requests for organizations
model OrgJoinRequest {
  id             String              @id @default(uuid())
  userId         String
  organizationId String
  status         OrgJoinRequestStatus @default(PENDING)
  message        String?             // Optional message from requester
  reviewedBy     String?             // Admin/owner who reviewed
  reviewedAt     DateTime?
  createdAt      DateTime            @default(now())

  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId, status])
  @@map("org_join_requests")
}

model Quote {
