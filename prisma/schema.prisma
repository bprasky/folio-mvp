  decayAt   DateTime
  updatedAt DateTime @default(now())

  @@index([srcType, srcId])
  @@index([dstType, dstId])
  @@index([kind])
  @@index([updatedAt])
  @@map("graph_edges")
}

model MarketSignal {
  id         String   @id @default(cuid())
  nodeType   String
  nodeId     String
  liquidity  Float
  momentum   Float
  confidence Float
  window     String
  updatedAt  DateTime @default(now())

  @@index([nodeType, nodeId])
  @@index([updatedAt])
  @@map("market_signals")
}

model SpendRecommendation {
  id             String   @id @default(cuid())
  vendorId       String
  scopeType      String // "event" | "product" | "category"
  scopeId        String
  recommendedUsd Float
  rationale      Json
  updatedAt      DateTime @default(now())

  @@index([vendorId, scopeType, scopeId])
  @@map("spend_recommendations")
}

// NOTE (designer onboarding):
// This model stores designer brand identity information (logo, colors, fonts).
// Created automatically when a designer account is first created.
