// ============================================================
// PROMPTED CONTENT SYSTEM
// ============================================================

enum PromptedQuestionType {
  BIO_REFLECTIVE
  CROSS_DOMAIN
  PROJECT_REFLECTIVE
  PEER_RESONANT
  STORY_COMPLETING
  FOLLOW_UP
}

enum StoryThreadStatus {
  FORMING
  MATURING
  READY
  PROPOSED
  PUBLISHED
  STALE
}

enum PromptedQuestionStatus {
  GENERATED
  DELIVERED
  ANSWERED
  SKIPPED
  EXPIRED
}

model PromptedQuestion {
  id              String   @id @default(cuid())
  targetUserId    String
  questionText    String   @db.Text
  questionType    PromptedQuestionType @default(BIO_REFLECTIVE)

  // Provenance — where this question came from
  provenance      Json     // { sourceType, bioExcerptRef?, patternDescription?, storyThreadId?, parentAnswerId? }
  atelierSignals  Json?    // { cluster, expectedSignals[] }

  // Delivery
  priority        Float    @default(0.5)
  deliveryContext String   @default("feed_card") // feed_card, profile_dashboard, notification, post_bio_prompt
  deliveredAt     DateTime?
  expiresAt       DateTime?

  // Status
  status          PromptedQuestionStatus @default(GENERATED)

  // Relations
  targetUser      User     @relation("UserPromptedQuestions", fields: [targetUserId], references: [id], onDelete: Cascade)
  answers         PromptedAnswer[]
  parentAnswer    PromptedAnswer?  @relation("FollowUpQuestions", fields: [parentAnswerId], references: [id])
  parentAnswerId  String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([targetUserId, status])
  @@index([status, priority])
  @@map("prompted_questions")
}

model PromptedAnswer {
  id              String   @id @default(cuid())
  questionId      String
  userId          String
  answerText      String   @db.Text
  videoUrl        String?
  transcriptRaw   String?  @db.Text

  // Bio enrichment
  profileQAId     String?
  bioEnriched     Boolean  @default(false)

  // Article contribution
  consentToQuote    Boolean  @default(true)
  storyThreadIds    String[]
  pullQuoteExcerpt  String?  @db.Text

  // Follow-ups
  followUpQuestions PromptedQuestion[] @relation("FollowUpQuestions")

  // Relations
  question        PromptedQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user            User             @relation("UserPromptedAnswers", fields: [userId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@index([questionId])
  @@map("prompted_answers")
}

model StoryThread {
  id                   String            @id @default(cuid())
  status               StoryThreadStatus @default(FORMING)

  themeDescription     String   @db.Text
  themeEmbedding       Unsupported("vector(1536)")?
  proposedAngle        String?  @db.Text
  proposedTitle        String?

  contributingAnswers  Json     // [{ answerId, userId, relevanceScore, pullQuoteCandidate }]
  supportingContext    Json     @default("[]")

  narrativeTension     Float    @default(0)
  perspectiveDiversity Float    @default(0)
  emotionalWeight      Float    @default(0)
  specificityScore     Float    @default(0)
  compositeScore       Float    @default(0)

  readyThresholds      Json     @default("{\"minContributors\": 3, \"minTensionScore\": 0.4, \"minSpecificityScore\": 0.5}")

  articlePostId        String?
  articlePost          ProjectPost? @relation(fields: [articlePostId], references: [id])

  createdAt            DateTime @default(now())
  lastActivityAt       DateTime @default(now())
  staleAfter           DateTime

  @@index([status])
  @@index([compositeScore])
  @@map("story_threads")
}

model EventProductScan {
  id          String   @id @default(cuid())
  eventId     String
  userId      String
  productId   String
  scanMethod  String   @default("qr")
  scannedAt   DateTime @default(now())
  autoSavedId String?
  boothId     String?
  notes       String?

  event   Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId, productId])
  @@index([eventId])
  @@index([userId])
  @@index([productId])
  @@index([eventId, productId])
  @@map("event_product_scans")
}

// ============================================================
// QR Exchange / Visit System
// ============================================================

enum VisitType {
  SHOWROOM
  EVENT
  TRADE_SHOW
  OTHER
}

model VisitRecord {
  id String @id @default(cuid())

  // Participants
  initiatorUserId String
  initiatorUser   User   @relation("initiatedVisits", fields: [initiatorUserId], references: [id])
  recipientUserId String
  recipientUser   User   @relation("receivedVisits", fields: [recipientUserId], references: [id])

  // Org context (captured at time of scan from operatingAsOrgId)
  initiatorOrgId String?
  initiatorOrg   Organization? @relation("orgInitiatedVisits", fields: [initiatorOrgId], references: [id])
  recipientOrgId String?
  recipientOrg   Organization? @relation("orgReceivedVisits", fields: [recipientOrgId], references: [id])

  // Visit context
  visitType VisitType @default(OTHER)
  eventId   String?
  event     Event?    @relation(fields: [eventId], references: [id])
  location  String?

  // Notes
  initiatorNotes String?
  recipientNotes String?

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  productShares VisitProductShare[]

  @@index([initiatorUserId])
  @@index([recipientUserId])
  @@index([initiatorOrgId])
  @@index([recipientOrgId])
  @@index([eventId])
  @@map("visit_records")
}

model VisitProductShare {
  id            String      @id @default(cuid())
  visitRecordId String
  visitRecord   VisitRecord @relation(fields: [visitRecordId], references: [id], onDelete: Cascade)
  productId     String
  product       Product     @relation(fields: [productId], references: [id])

  sharedByUserId   String
  autoShared       Boolean @default(false) // true = auto-pulled from org catalog
  savedByRecipient Boolean @default(false)
  savedToProjectId String?

  createdAt DateTime @default(now())

  @@unique([visitRecordId, productId])
  @@index([visitRecordId])
  @@index([productId])
  @@map("visit_product_shares")
}

// Territory & Governance (Phase 3)
model OrgTerritoryAssignment {
  id            String       @id @default(cuid())
  vendorOrgId   String
  vendorOrg     Organization @relation("VendorTerritoryAssignments", fields: [vendorOrgId], references: [id])
  repUserId     String
  repUser       User         @relation("RepTerritoryAssignments", fields: [repUserId], references: [id])
  designerOrgId String
  designerOrg   Organization @relation("DesignerTerritoryAssignments", fields: [designerOrgId], references: [id])

  assignedBy String   // org admin who made the assignment
  assignedAt DateTime @default(now())
  expiresAt  DateTime? // optional expiry for temporary assignments

  @@unique([vendorOrgId, designerOrgId]) // one primary rep per designer org
  @@index([vendorOrgId])
  @@index([repUserId])
  @@map("org_territory_assignments")
}

// Interview-first profile: tracks field-level sourcing
model ProfileFieldSource {
  id             String  @id @default(cuid())
  userId         String?
  organizationId String?

  fieldName          String
  source             ProfileFieldSourceType
  interviewSessionId String? // OrgBioInterview or ProfileInterview id
  extractedAt        DateTime?
  manuallyEditedAt   DateTime?

  user         User?         @relation(fields: [userId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])

  @@unique([userId, fieldName])
  @@unique([organizationId, fieldName])
  @@map("profile_field_sources")
}

enum ProfileFieldSourceType {
  INTERVIEW_EXTRACTED
  MANUALLY_ENTERED
  INTERVIEW_THEN_EDITED
}

// Relationship Graph
enum RelationshipTier {
  FOLLOW
  CONNECTION
  FIRM_CONNECTION
}

model UserRelationship {
  id              String           @id @default(cuid())
  followerId      String
  followingId     String
  follower        User             @relation("Follower", fields: [followerId], references: [id])
  following       User             @relation("Following", fields: [followingId], references: [id])

  // Tier classification
  tier            RelationshipTier @default(FOLLOW)
  tierUpdatedAt   DateTime         @default(now())
  isMutual        Boolean          @default(false)

  // Firm connection qualifying signals
  qrExchangeCount    Int           @default(0)
  messageCount       Int           @default(0)
  specExchangeCount  Int           @default(0)
  sharedProjectCount Int           @default(0)
  tagOverlapCount    Int           @default(0)
  coEventCount       Int           @default(0)
  lastActivityAt     DateTime?

  // Scoring
  engagementScore     Float?
  engagementUpdatedAt DateTime?

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([followerId, followingId])
  @@index([followingId])
  @@index([tier])
  @@map("user_relationships")
}

// ─── Messaging System ───────────────────────────────────────────────────────

model Conversation {
  id String @id @default(cuid())

  // Participants — one or both may be orgs or users
  initiatorUserId String?
  initiatorOrgId  String?
  recipientUserId String?
  recipientOrgId  String?

  // Thread metadata
  subject String?
  context ConversationContext @default(GENERAL)
  status  ConversationStatus @default(ACTIVE)

  // Structured request categorization
  category       MessageCategory @default(GENERAL)
  structuredData Json?           // Action-specific payload (quantity, timeline, finish, etc.)

  // Attribution context (for vendor → designer threads)
  attributionNote String?
  productId       String?

  // Timestamps
  lastMessageAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  messages     Message[]
  participants ConversationParticipant[]

  initiatorUser User?         @relation("InitiatedConversations", fields: [initiatorUserId], references: [id])
  initiatorOrg  Organization? @relation("OrgInitiatedConversations", fields: [initiatorOrgId], references: [id])
  recipientUser User?         @relation("ReceivedConversations", fields: [recipientUserId], references: [id])
  recipientOrg  Organization? @relation("OrgReceivedConversations", fields: [recipientOrgId], references: [id])

  // Email thread linkage
  emailThread   EmailThread?  @relation("EmailThreadConversation")

  @@index([recipientOrgId, status])
  @@index([recipientUserId, status])
  @@index([initiatorUserId])
  @@index([lastMessageAt])
  @@index([context])
  @@map("conversations")
}

model Message {
  id             String  @id @default(cuid())
  conversationId String
  senderUserId   String
  senderOrgId    String?

  body String

  // Read receipts
  readAt       DateTime?
  readByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conversation Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User          @relation(fields: [senderUserId], references: [id])
  senderOrg    Organization? @relation(fields: [senderOrgId], references: [id])

  @@index([conversationId, createdAt])
  @@map("messages")
}

model ConversationParticipant {
  id             String  @id @default(cuid())
  conversationId String
  userId         String
  orgId          String?

  // Per-participant state
  lastReadAt  DateTime?
  isArchived  Boolean   @default(false)
  isMuted     Boolean   @default(false)
  unreadCount Int       @default(0)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id])

  @@unique([conversationId, userId])
  @@map("conversation_participants")
}

model MessagingPreferences {
  id     String @id @default(cuid())
  userId String @unique

  // Email notification settings
  emailOnNewMessage        Boolean              @default(true)
  emailOnNewInquiry        Boolean              @default(true)
  emailDigestFrequency     EmailDigestFrequency @default(IMMEDIATE)
  emailNotificationAddress String?

  // In-app notification settings
  pushOnNewMessage Boolean @default(true)

  // Per-category notification preferences (Phase 5)
  emailOnSampleRequest Boolean @default(true)
  emailOnQuoteRequest  Boolean @default(true)
  emailOnReorderRequest Boolean @default(true)
  emailOnCollaboration Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@map("messaging_preferences")
}

enum ConversationContext {
  GENERAL
  CLIENT_INQUIRY
  VENDOR_OUTREACH
  PEER
  PLATFORM
  FOLIO_EMAIL
}

enum ConversationStatus {
  ACTIVE
  ARCHIVED
  BLOCKED
}

enum EmailDigestFrequency {
  IMMEDIATE
  HOURLY
  DAILY
  NEVER
}

enum MessageCategory {
  SAMPLE_REQUEST
  QUOTE_REQUEST
  REORDER_REQUEST
  COLLABORATION
  GENERAL
}

enum PendingActionStatus {
  PENDING
  DELIVERED
  EXPIRED
  CANCELLED
  EMAIL_SENT
}

// PostSave: bookmark/save for editorial posts (separate from product Save)
model PostSave {
