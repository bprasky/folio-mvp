  note          String? // agenda, context
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())

  @@index([vendorId])
  @@index([projectId])
  @@index([designerEmail])
  @@index([projectId, createdAt])
  @@map("VendorVisit")
}

model QuoteAttachment {
  id           String           @id @default(cuid())
  vendorId     String
  projectId    String? // becomes non-null after destination chosen
  roomId       String?
  selectionId  String?
  fileUrl      String?
