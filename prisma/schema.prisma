  // Post metadata
  postType    String // "launch" | "room_spotlight" | "product_feature" | "quote" | "detail" | "closer"
  sequenceNum Int    // 1, 2, 3... (for "1 of 6")

  // Content
  title    String?
  caption  String
  hashtags String[]

  // Assets
  format     String[] // ["square", "portrait", "story"]
  imageIds   String[] // ProjectImage IDs used
  productIds String[] // Products featured (if applicable)
  roomName   String?  // Room featured (if applicable)

  // Generated file URLs
  fileUrls Json? // { square: "url", portrait: "url", story: "url" }

  createdAt DateTime @default(now())

  @@index([campaignId, sequenceNum])
  @@map("instagram_campaign_posts")
}

