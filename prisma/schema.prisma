  userId        String
  projectPostId String
  createdAt     DateTime    @default(now())

  user          User        @relation("UserPostSaves", fields: [userId], references: [id], onDelete: Cascade)
  projectPost   ProjectPost @relation(fields: [projectPostId], references: [id], onDelete: Cascade)

  @@unique([userId, projectPostId])
  @@index([userId, createdAt])
  @@index([projectPostId])
  @@map("post_saves")
}

// ─── Sourcebook System ────────────────────────────────────────────

model SourcebookEntry {
