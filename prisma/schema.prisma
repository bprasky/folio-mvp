model OrgMedia {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  type            MediaType
  title           String
  description     String?
  thumbnailUrl    String?
  sourceUrl       String?      // YouTube, Spotify URL
  hostedUrl       String?      // Folio-hosted
  duration        Int?

  views           Int          @default(0)
  saves           Int          @default(0)

  publishedAt     DateTime?
  pinnedAt        DateTime?
  pinOrder        Int?

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([organizationId, publishedAt])
  @@map("org_media")
}

// Organization recognition (press, awards)
model OrgRecognition {
  id              String          @id @default(cuid())
  organizationId  String
  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  type            RecognitionType
  title           String
  source          String
  sourceLogoUrl   String?
  date            DateTime
  url             String?
  imageUrl        String?
  excerpt         String?

  publishedAt     DateTime?
  pinnedAt        DateTime?
  pinOrder        Int?

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([organizationId, date])
  @@map("org_recognition")
}

// Organization collaborations
model OrgCollaboration {
  id              String        @id @default(cuid())
  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  type            CollabType
  title           String
  description     String?
  partnerName     String?
  partnerLogoUrl  String?
  imageUrl        String?

  publishedAt     DateTime?
  pinnedAt        DateTime?
  pinOrder        Int?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([organizationId, publishedAt])
  @@map("org_collaboration")
}

model RankingHistory {
  id          String           @id @default(cuid())
  rankingId   String
  ranking     DirectoryRanking @relation(fields: [rankingId], references: [id], onDelete: Cascade)

  rank        Int
  totalScore  Float
  recordedAt  DateTime         @default(now())

  @@index([rankingId, recordedAt])
  @@map("ranking_history")
}

// ============================================================
// PRESALE/DEVELOPER MODELS
// Real estate development listings and finish package configuration
// ============================================================

// Represents a real estate development listing
model Development {
  id                   String              @id @default(cuid())
  developerOrgId       String
  developerOrg         Organization        @relation(fields: [developerOrgId], references: [id])

  name                 String
  slug                 String              @unique
  description          String?             @db.Text

  // Location
  address              String
  city                 String
  state                String
  country              String              @default("USA")

  // Development details
  totalUnits           Int
  status               DevelopmentStatus   @default(PLANNING)
  expectedCompletion   DateTime?

  // Atelier consultations enabled
  consultationsEnabled Boolean             @default(false)
  defaultDesignerId    String?             // Default Atelier for this development

  // Imagery
  heroImageUrl         String?
  galleryUrls          String[]            @default([])

  // Timestamps
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  publishedAt          DateTime?

  // Relations
  unitTypes            UnitType[]
  finishPackages       FinishPackage[]
  productCatalog       DevelopmentProduct[]
  designerPool         DevelopmentDesigner[]
  consultations        Consultation[]
  consultationBuyers   ConsultationBuyer[]
  deployments          AtelierDeployment[]

  @@index([status])
  @@index([city, state])
  @@index([developerOrgId])
  @@map("developments")
}

// Unit type within a development (e.g., "2BR Corner", "Penthouse")
model UnitType {
  id                   String              @id @default(cuid())
  developmentId        String
  development          Development         @relation(fields: [developmentId], references: [id], onDelete: Cascade)

  name                 String              // "2BR Corner Unit"
  code                 String              // "2BR-C"
  squareFootage        Int?
  bedrooms             Int
  bathrooms            Float

  // Base price
  basePriceCents       Int?

  // Floor plan
  floorPlanUrl         String?

  createdAt            DateTime            @default(now())

  // Relations
  rooms                UnitTypeRoom[]
  consultations        Consultation[]

  @@unique([developmentId, code])
  @@map("unit_types")
}

// Rooms within a unit type
model UnitTypeRoom {
  id                   String              @id @default(cuid())
  unitTypeId           String
  unitType             UnitType            @relation(fields: [unitTypeId], references: [id], onDelete: Cascade)

  name                 String              // "Primary Bathroom"
  type                 String              // "BATH"

  // Finish slots available
  finishSlots          FinishSlot[]

  @@map("unit_type_rooms")
}

// Finish slot configuration within a room
model FinishSlot {
  id                   String              @id @default(cuid())
  unitTypeRoomId       String
  unitTypeRoom         UnitTypeRoom        @relation(fields: [unitTypeRoomId], references: [id], onDelete: Cascade)

  key                  String              // "countertop", "faucet"
  label                String              // "Kitchen Countertop"
  category             String              // Product category constraint

  // Whether buyer can customize
  isCustomizable       Boolean             @default(true)

  @@unique([unitTypeRoomId, key])
  @@map("finish_slots")
}

// Constrained product catalog for a development
model DevelopmentProduct {
  id                   String              @id @default(cuid())
  developmentId        String
  development          Development         @relation(fields: [developmentId], references: [id], onDelete: Cascade)

  productId            String
  product              Product             @relation(fields: [productId], references: [id])

  // Availability constraints
  availableInPackages  FinishPackageTier[] @default([STANDARD])
  isUpgrade            Boolean             @default(false)
  upgradePriceCents    Int?                // Additional cost if upgrade

  // Slot restriction
  allowedSlots         String[]            @default([]) // e.g., ["countertop", "backsplash"]

  createdAt            DateTime            @default(now())

  // Relations
  finishPackageDefaults FinishPackageDefault[]
  consultationSelections ConsultationSelection[]

  @@unique([developmentId, productId])
  @@index([developmentId])
  @@map("development_products")
}

// Finish package template
model FinishPackage {
  id                   String              @id @default(cuid())
  developmentId        String
  development          Development         @relation(fields: [developmentId], references: [id], onDelete: Cascade)

  name                 String              // "Designer Collection"
  tier                 FinishPackageTier
  description          String?

  // Price delta from base
  priceDeltaCents      Int                 @default(0)

  // Imagery
  heroImageUrl         String?

  createdAt            DateTime            @default(now())

  // Relations
  defaultSelections    FinishPackageDefault[]
  consultations        Consultation[]

  @@unique([developmentId, tier])
  @@map("finish_packages")
}

// Default product for a slot in a finish package
model FinishPackageDefault {
  id                   String              @id @default(cuid())
  finishPackageId      String
  finishPackage        FinishPackage       @relation(fields: [finishPackageId], references: [id], onDelete: Cascade)

  slotKey              String              // "countertop", "faucet"
  roomType             String              // "KITCHEN", "BATH"
  developmentProductId String
  developmentProduct   DevelopmentProduct  @relation(fields: [developmentProductId], references: [id])

  @@unique([finishPackageId, slotKey, roomType])
  @@map("finish_package_defaults")
}

// Designers available for consultations on a development
model DevelopmentDesigner {
  id                   String              @id @default(cuid())
  developmentId        String
  development          Development         @relation(fields: [developmentId], references: [id], onDelete: Cascade)

  designerId           String
  designer             User                @relation(fields: [designerId], references: [id])

  // Commission structure
  consultationFeeShare Float               @default(0.7) // 70% to designer

  // Availability
  isActive             Boolean             @default(true)

  createdAt            DateTime            @default(now())

  @@unique([developmentId, designerId])
  @@map("development_designers")
}

// ============================================================
// CONSULTATION MODELS
// Buyer consultation sessions with designer Ateliers
// ============================================================

// A buyer consultation session
model Consultation {
  id                   String              @id @default(cuid())

  // Context
  developmentId        String
  development          Development         @relation(fields: [developmentId], references: [id])
  unitTypeId           String?
  unitType             UnitType?           @relation(fields: [unitTypeId], references: [id])
  finishPackageId      String?             // Starting package
  finishPackage        FinishPackage?      @relation(fields: [finishPackageId], references: [id])

  // Participants
  buyerId              String              // User ID (INDIVIDUAL or lightweight)
  buyer                User                @relation("BuyerConsultations", fields: [buyerId], references: [id])
  designerId           String
  designer             User                @relation("DesignerConsultations", fields: [designerId], references: [id])
  deploymentId         String?             // Atelier deployment used
  deployment           AtelierDeployment?  @relation(fields: [deploymentId], references: [id])

  // Session
  status               ConsultationStatus  @default(SCHEDULED)
  scheduledAt          DateTime?
  startedAt            DateTime?
  completedAt          DateTime?
  durationMinutes      Int?

  // Conversation
  conversationHistory  Json?               // Message array

  // Outcomes
  summary              String?             @db.Text // AI-generated summary
  designerNotes        String?             @db.Text

  // Attribution
  attributionLocked    Boolean             @default(false)

  // Pricing
  consultationFeeCents Int?
  designerEarningsCents Int?

  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  // Relations
  selections           ConsultationSelection[]

  @@index([buyerId])
  @@index([designerId])
  @@index([developmentId, status])
  @@map("consultations")
}

// Product selection made during consultation
model ConsultationSelection {
  id                   String              @id @default(cuid())
  consultationId       String
  consultation         Consultation        @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  // What was selected
  slotKey              String
  roomType             String
  developmentProductId String
  developmentProduct   DevelopmentProduct  @relation(fields: [developmentProductId], references: [id])

  // Designer reasoning (for Atelier learning)
  reasoning            String?             @db.Text
  alternatives         Json?               // Other options considered

  // Buyer acceptance
  buyerAccepted        Boolean             @default(true)
  buyerNote            String?

  createdAt            DateTime            @default(now())

  @@unique([consultationId, slotKey, roomType])
  @@map("consultation_selections")
}

// Lightweight buyer record (can exist without full User)
model ConsultationBuyer {
  id                   String              @id @default(cuid())

  // Contact info (may not have full account)
  email                String
  name                 String
  phone                String?

  // Optional link to User (if they create account)
  userId               String?             @unique
  user                 User?               @relation(fields: [userId], references: [id])

  // Development context
  developmentId        String
  development          Development         @relation(fields: [developmentId], references: [id])
  unitNumber           String?             // Their specific unit

  // Session token for lightweight auth
  sessionToken         String              @unique
  sessionExpiresAt     DateTime

  createdAt            DateTime            @default(now())

  @@unique([email, developmentId])
  @@index([sessionToken])
  @@map("consultation_buyers")
}

// ============================================================
// ATELIER DEPLOYMENT MODELS
// Deployed Atelier instances with context constraints
// ============================================================

// Deployed Atelier instance with context constraints
model AtelierDeployment {
  id                   String              @id @default(cuid())

  fingerprintId        String
  fingerprint          AtelierFingerprint  @relation(fields: [fingerprintId], references: [id])

  deploymentType       AtelierDeploymentType

  // Context constraints
  developmentId        String?             // If DEVELOPMENT_CONSULTATION
  development          Development?        @relation(fields: [developmentId], references: [id])

  // System prompt augmentation
  contextPrompt        String?             @db.Text // Additional context for AI

  // Behavior configuration
  config               Json?               // Temperature, response style, etc.

  isActive             Boolean             @default(true)

  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  // Relations
  consultations        Consultation[]

  @@index([fingerprintId, isActive])
  @@index([developmentId])
  @@map("atelier_deployments")
}

// ============================================================
// PDF SPECIFICATION EXTRACTION SYSTEM
// Extract structured product data from PDF presentations
// ============================================================

enum SkeletonItemStatus {
  UNCONFIRMED
  CONFIRMED
  DISMISSED
}

model PdfExtraction {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fileName    String
  result      Json     // ExtractionResult from extractionPipeline
  status      String   @default("pending_review") // pending_review, completed, cancelled
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("pdf_extractions")
  @@index([projectId])
  @@index([createdBy])
  @@index([status])
}

model SkeletonItem {
  id                 String             @id @default(cuid())
  roomId             String
  room               Room               @relation(fields: [roomId], references: [id], onDelete: Cascade)
  projectId          String
  project            Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // For AI search functionality
  searchQuery        String?
  description        String?
  imageData          String?            @db.Text  // Base64 or URL
  imageUrl           String?            // Uploaded image URL

  // Extracted data (from PDF)
  extractedBrand     String?
  extractedPrice     Int?               // In cents
  extractedMaterial  String?
  extractedDimensions Json?             // ParsedDimensions object

  // Source tracking
  sourceExtractionId String?            // Link to PdfExtraction
  sourcePage         Int?               // Page number in PDF

  // Matching - when user confirms a product for this skeleton
  confirmedProductId String?
  confirmedProduct   Product?           @relation(fields: [confirmedProductId], references: [id])

  // Resulting selection after confirmation
  resultingSelectionId String?          @unique

  status             SkeletonItemStatus @default(UNCONFIRMED)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@map("skeleton_items")
  @@index([roomId])
  @@index([projectId])
  @@index([status])
  @@index([sourceExtractionId])
}

// ============================================================
// VENDOR BOOST SYSTEM
// Testimonial marketplace for designer-vendor mentions
// ============================================================

enum BoostStatus {
  PENDING      // Created, not yet notified
  NOTIFIED     // Vendor has been notified
  VIEWED       // Vendor has viewed the opportunity
  BOOSTED      // Vendor has boosted
  DECLINED     // Vendor explicitly declined
  EXPIRED      // Passed expiration without action
}

// Designer Shop Boost Status (separate from BoostOpportunity system)
enum ShopBoostStatus {
  PENDING
  APPROVED
  ACTIVE
  DECLINED
  EXPIRED
  CANCELLED
}

model BoostOpportunity {
  id                 String       @id @default(cuid())

  // Source
  projectId          String
  project            Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  questionId         String       // Reference to the question asked

  // The content
  designerId         String
  designer           User         @relation("DesignerBoostOpportunities", fields: [designerId], references: [id])
  vendorId           String
  vendor             Organization @relation("VendorBoostOpportunities", fields: [vendorId], references: [id])

  // Quote details
  fullAnswer         String       @db.Text
  suggestedPullQuote String?      @db.Text
  productIds         String[]     // Products mentioned
  sentiment          String       // positive, neutral

  // Status
  status             BoostStatus  @default(PENDING)
  notifiedAt         DateTime?
  viewedAt           DateTime?
  respondedAt        DateTime?
  expiresAt          DateTime     // Boost opportunities expire after 14 days

  // If boosted
  boost              Boost?

  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@map("boost_opportunities")
  @@index([vendorId, status])
  @@index([projectId])
  @@index([designerId])
}

model Boost {
  id                  String           @id @default(cuid())

  // Source
  opportunityId       String           @unique
  opportunity         BoostOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  // Vendor
  vendorId            String
  vendor              Organization     @relation("VendorBoosts", fields: [vendorId], references: [id])
  boostedById         String           // User who approved the boost
  boostedBy           User             @relation("UserBoosts", fields: [boostedById], references: [id])

  // Content (may be edited from suggested)
  pullQuote           String           @db.Text

  // Placement preferences
  showInArticle       Boolean          @default(true)
  showOnVendorPage    Boolean          @default(true)
  showInFeed          Boolean          @default(false) // Premium placement

  // Display settings
  priority            Int              @default(0) // Higher = more prominent
  displayUntil        DateTime?        // Optional expiration

  // Billing
  boostTier           String           // 'included', 'premium', 'featured'
  amountCents         Int              @default(0)
  billedAt            DateTime?

  // Stats
  impressions         Int              @default(0)
  clicks              Int              @default(0)

  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@map("boosts")
  @@index([vendorId])
}

// Vendor invite signals for vendors not yet on platform
model VendorInviteSignal {
  id          String   @id @default(cuid())
  vendorName  String
  signalType  String   // 'TESTIMONIAL_AVAILABLE', 'PRODUCT_TAG', etc.
  projectId   String?
  designerId  String?
  metadata    Json?
  processedAt DateTime?
  createdAt   DateTime @default(now())

  @@map("vendor_invite_signals")
  @@index([vendorName])
  @@index([signalType])
}

// In-app notification system
model Notification {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String   // 'BOOST_OPPORTUNITY', 'TESTIMONIAL_BOOSTED', etc.
  title      String
  body       String
  actionUrl  String?
  metadata   Json?
  read       Boolean  @default(false)
  readAt     DateTime?
  createdAt  DateTime @default(now())

  @@map("notifications")
  @@index([userId, read])
  @@index([createdAt])
}

// Product search logging for business intelligence
// Tracks what designers search for to build vendor demand signals
model ProductSearchLog {
  id            String   @id @default(cuid())

  // Who searched
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgId         String?  // Designer's organization if applicable

  // What they searched for
  searchType    String   // 'FOLIO_SEARCH', 'AI_COMPLETE', 'URL_IMPORT'
  brandName     String?  // Extracted or searched brand
  productName   String?  // Product name searched
  searchQuery   String?  // Raw search query

  // Context
  selectionId   String?  // If search was for a specific selection
  projectId     String?  // Which project it was for

  // Results
  wasSuccessful Boolean  @default(false)
  matchedProductId String? // If found a match in Folio
  resultData    Json?    // Additional result metadata

  // Timestamps
  createdAt     DateTime @default(now())

  @@map("product_search_logs")
  @@index([brandName])
  @@index([userId])
  @@index([searchType])
  @@index([createdAt])
}

// Designer's personal directory of vendor rep contacts
// Allows designers to store and manage rep relationships
model VendorRepContact {
  id            String   @id @default(cuid())

  // Owner (designer)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Rep information
  repName       String
  repEmail      String?
  repPhone      String?
  repTitle      String?  // e.g., "Territory Sales Rep", "Account Manager"

  // Vendor/Brand association
  vendorName    String   // Brand they represent (e.g., "FOURHANDS", "RH")
  vendorOrgId   String?  // Link to Organization if vendor is on platform

  // Preferences
  preferredContact String? // 'email', 'phone', 'text'
  notes         String?  @db.Text // Personal notes about this rep

  // Trade account info with this rep/vendor
  hasTradeAccount Boolean @default(false)
  tradeAccountNumber String?
  tradeDiscount   Decimal? @db.Decimal(5, 2) // e.g., 40.00 for 40%

  // Status
  isActive      Boolean  @default(true)
  lastContactedAt DateTime?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, vendorName]) // One rep per vendor per designer
  @@map("vendor_rep_contacts")
  @@index([userId])
  @@index([vendorName])
}

// ============================================================
// ORGANIZATION ONBOARDING SYSTEM
// ============================================================

enum TeamSizeRange {
  SOLO
  SMALL_2_5
  MEDIUM_6_15
  LARGE_16_50
  ENTERPRISE_50_PLUS
}

enum TeamInviteStatus {
  PENDING
  CLAIMED
  EXPIRED
  CANCELLED
}

enum PartnershipStatus {
  PENDING     // Design firm added, vendor not confirmed
  CONFIRMED   // Vendor confirmed the partnership
  DECLINED    // Vendor declined
}

// Organization onboarding progress tracking
model OrgOnboardingProgress {
  id              String       @id @default(cuid())
  organizationId  String       @unique
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  bioInterviewComplete        Boolean @default(false)
  studioDetailsComplete       Boolean @default(false)
  teamSetupComplete           Boolean @default(false)
  processComplete             Boolean @default(false)
  recognitionComplete         Boolean @default(false)
  vendorRelationshipsComplete Boolean @default(false)
  pinnedWorkComplete          Boolean @default(false)

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@map("org_onboarding_progress")
}

// Bio interview responses (preserves raw answers for reprocessing)
model OrgBioInterview {
  id              String       @id @default(cuid())
  organizationId  String       @unique
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Layer 1 responses
  originStory       String?   @db.Text
  philosophyStatement String?
  projectTypes      String[]
  location          String?
  serviceRegions    String[]
  idealClient       String?   @db.Text

  // Layer 2 responses (contextual follow-ups)
  layer2Responses   Json?     // { questionId: answer } for contextual questions

  // Layer 3 responses (proof points)
  representativeProjectId String?
  recognitionMentions     String?   @db.Text
  collaboratorMentions    String?   @db.Text

  // AI-generated outputs
  fullBio           String?   @db.Text
  shortBio          String?   // 80 words for cards
  pullQuotes        Json?     // string[]
  philosophyTagline String?   // one-liner
  processDescription String?  @db.Text

  generatedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@map("org_bio_interview")
}

// Team member invitations
model TeamMemberInvite {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  email           String
  role            String       // "Principal", "Senior Designer", etc.
  invitedById     String
  invitedBy       User         @relation("InvitedTeamMembers", fields: [invitedById], references: [id])

  status          TeamInviteStatus @default(PENDING)
  claimedAt       DateTime?
  claimedByUserId String?
  claimedBy       User?        @relation("ClaimedInvites", fields: [claimedByUserId], references: [id])

  token           String       @unique @default(cuid())
  createdAt       DateTime     @default(now())
  expiresAt       DateTime

  @@unique([organizationId, email])
  @@index([token])
  @@map("team_member_invite")
}

// Team member quiz responses (for users linked to org)
model TeamMemberQuiz {
  id              String       @id @default(cuid())

  // Links to OrganizationUser (the team membership)
  orgUserId       String       @unique
  orgUser         OrganizationUser @relation(fields: [orgUserId], references: [id], onDelete: Cascade)

  // Basic info captured at join
  joinDate        DateTime?
  specialties     String[]

  // Quiz answers
  whatBroughtYou  String?      @db.Text
  roleInProcess   String?      @db.Text
  proudestProject String?      @db.Text
  background      String?      @db.Text

  // Contextual questions (based on org bio)
  contextualAnswers Json?      // { questionKey: answer }

  // AI-generated outputs
  teamBlurb       String?      // 2-3 sentences for org profile
  extendedBio     String?      @db.Text // for personal profile
  pullQuote       String?
  expertiseTags   String[]

  // Privacy settings
  showOnPersonalProfile Boolean @default(false)
  showRoleOnProfile     Boolean @default(true)

  generatedAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@map("team_member_quiz")
}

// Organization process phases
model OrgProcessPhase {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name            String
  description     String?      @db.Text
  order           Int

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([organizationId, order])
  @@index([organizationId])
  @@map("org_process_phase")
}

// Vendor partnerships (org to vendor org relationship)
model OrgVendorPartnership {
  id                  String       @id @default(cuid())
  designFirmOrgId     String
  designFirmOrg       Organization @relation("DesignFirmPartnerships", fields: [designFirmOrgId], references: [id], onDelete: Cascade)

  vendorOrgId         String
  vendorOrg           Organization @relation("VendorPartnerships", fields: [vendorOrgId], references: [id], onDelete: Cascade)

  status              PartnershipStatus @default(PENDING)
  addedByUserId       String
  confirmedAt         DateTime?

  createdAt           DateTime     @default(now())

  @@unique([designFirmOrgId, vendorOrgId])
  @@index([vendorOrgId])
  @@map("org_vendor_partnership")
}

// ============================================================
// INTELLIGENCE SYSTEM - User taste signals, patterns, and profiles
// See docs/12_INTELLIGENCE_SYSTEM.md for full specification
// ============================================================

// Layer 1: Signal Capture - Likes (impulsive engagement)
model Like {
  id                String   @id @default(cuid())
  userId            String
  productId         String
  createdAt         DateTime @default(now())

  // Extracted attributes (populated async from product)
  productAttributes Json?    // { colors: [], materials: [], shapes: [], styles: [] }

  user              User     @relation("UserLikes", fields: [userId], references: [id], onDelete: Cascade)
  product           Product  @relation("ProductLikes", fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId, createdAt])
  @@index([productId])
  @@map("likes")
}

// Layer 1: Signal Capture - Saves (intentional engagement)
model Save {
  id                String   @id @default(cuid())
  userId            String
  productId         String

  // Organization
  boardId           String?
  roomType          String?  // "living_room", "bedroom", "kitchen", etc.

  // Extracted attributes (populated async from product)
  productAttributes Json?    // { colors: [], materials: [], shapes: [], styles: [] }

  // Conversion tracking
  converted         Boolean  @default(false)
  convertedAt       DateTime?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User     @relation("UserSaves", fields: [userId], references: [id], onDelete: Cascade)
  product           Product  @relation("ProductSaves", fields: [productId], references: [id], onDelete: Cascade)
  board             Board?   @relation(fields: [boardId], references: [id], onDelete: SetNull)

  @@unique([userId, productId])
  @@index([userId, boardId])
  @@index([userId, createdAt])
  @@index([productId])
  @@map("saves")
}

// Layer 1 & 5: Boards for organizing saves
model Board {
  id            String   @id @default(cuid())
  userId        String
  name          String
  type          String   // 'room', 'style', 'inspiration', 'auto'
  roomType      String?  // If type='room': 'living_room', 'bedroom', etc.

  // Auto-generated boards track their source
  autoGenerated Boolean  @default(false)
  autoSource    String?  // 'room_clustering', 'style_clustering'

  // Cover image (first save's product image or custom)
  coverImageUrl String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation("UserBoards", fields: [userId], references: [id], onDelete: Cascade)
  saves         Save[]

  @@index([userId])
  @@index([userId, type])
  @@map("boards")
}

// Layer 2: Pattern Inference - Detected taste patterns
model TasteInference {
  id              String    @id @default(cuid())
  userId          String

  attribute       String    // "curved", "green", "velvet", "warm_modern"
  attributeType   String    // "shape", "color", "material", "style"

  confidence      Float     // 0-1 based on pattern strength
  evidence        String    // Human-readable explanation
  source          String    // "frequency", "cross_pattern", "clustering"

  // User confirmation
  confirmedByUser Boolean?  // null = not asked, true = yes, false = no
  confirmedAt     DateTime?

  // Display tracking
  shownToUser     Boolean   @default(false)
  shownAt         DateTime?
  dismissedAt     DateTime?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User      @relation("UserTasteInferences", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, attribute])
  @@index([userId, confirmedByUser])
  @@index([userId, shownToUser])
  @@map("taste_inferences")
}

// Layer 5: User Taste Profile - Self-discovery dashboard
model UserTasteProfile {
  id                  String    @id @default(cuid())
  userId              String    @unique

  // AI-generated summary
  styleName           String?   // "Warm Modern with Art Deco influence"
  styleDescription    String?   @db.Text // Full paragraph description

  // Confirmed preferences (high confidence)
  confirmedAttributes String[]

  // Stats
  totalLikes          Int       @default(0)
  totalSaves          Int       @default(0)
  profileStrength     Float     @default(0) // 0-1 based on confirmations

  // Milestones
  firstInsightAt      DateTime?
  styleNamedAt        DateTime?

  // Fingerprint vector for matching
  fingerprintVector   Json?     // Numeric vector for similarity matching

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user                User      @relation("UserTasteProfile", fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_taste_profiles")
}

// Layer 6: Supplemental Quotes - Designer micro-answers
model SupplementalQuote {
  id              String   @id @default(cuid())
  projectPostId   String
  productTagId    String?  // If quote is about a specific product

  question        String
  answer          String   @db.Text
  source          String   // 'welcome_back', 'trend_interview', 'user_question'

  // Display control
  pinned          Boolean  @default(false)
  displayLocation String?  // 'near_product', 'sidebar', 'end_of_post'

  createdAt       DateTime @default(now())

  post            ProjectPost @relation("PostSupplementalQuotes", fields: [projectPostId], references: [id], onDelete: Cascade)
  productTag      ProductTag? @relation("ProductTagQuotes", fields: [productTagId], references: [id], onDelete: SetNull)

  @@index([projectPostId])
  @@index([productTagId])
  @@map("supplemental_quotes")
}

// Layer 6: Trend Detection - Rising signals across platform
model TrendSignal {
  id                 String    @id @default(cuid())

  signalType         String    // 'search', 'save', 'like', 'tag_density'
  topic              String    // 'green chair', 'brass fixtures', 'curved sofa'
  topicType          String    // 'product', 'color', 'material', 'shape', 'style'

  // Metrics
  currentVolume      Int       // This period's count
  previousVolume     Int       // Last period's count
  growthRate         Float     // Percentage increase
  magnitude          Float     // How strong is the spike (0-1)

  // Related entities
  topProducts        String[]  // Product IDs driving the trend
  topDesigners       String[]  // Designers who tagged trending items

  // Status
  status             String    @default("detected") // 'detected', 'interviewing', 'published', 'expired'

  // Output
  generatedArticleId String?

  detectedAt         DateTime  @default(now())
  expiresAt          DateTime

  interviewRequests  TrendInterviewRequest[]

  // Contributor/Voice System relations
  generatedTopics    ArticleTopic[] @relation("TrendGeneratedTopics")

  @@index([status])
  @@index([topicType])
  @@index([detectedAt])
  @@map("trend_signals")
}

// Layer 6: Trend Interview Requests - Designer micro-interviews
model TrendInterviewRequest {
  id              String    @id @default(cuid())
  trendSignalId   String
  designerId      String
  projectId       String
  productTagId    String?

  // The question (AI-generated based on trend)
  question        String

  // Response
  answer          String?   @db.Text
  answeredAt      DateTime?

  // Status
  status          String    @default("pending") // 'pending', 'answered', 'skipped', 'expired'

  // Quality signals
  engagementScore Float?    // How good is this project for the trend

  createdAt       DateTime  @default(now())
  expiresAt       DateTime

  trendSignal     TrendSignal @relation(fields: [trendSignalId], references: [id], onDelete: Cascade)
  designer        User        @relation("DesignerTrendInterviews", fields: [designerId], references: [id], onDelete: Cascade)
  project         Project     @relation("ProjectTrendInterviews", fields: [projectId], references: [id], onDelete: Cascade)

  @@index([trendSignalId])
  @@index([designerId, status])
  @@index([projectId])
  @@map("trend_interview_requests")
}

// Layer 7: Vendor Content Opportunity - Monetization
model VendorContentOpportunity {
  id               String    @id @default(cuid())
  vendorId         String    // Organization ID
  productId        String

  // Engagement that triggered this
  likeCount        Int
  saveCount        Int
  uncommittedCount Int
  designerTagCount Int

  // Distribution estimate
  tier1Reach       Int       // Direct engagers
  tier2Reach       Int       // Fingerprint matches
  tier3Reach       Int       // Designer followers
  totalReach       Int

  // Status
  status           String    @default("available") // 'available', 'in_progress', 'published', 'expired'

  // If published
  articleId        String?
  publishedAt      DateTime?

  createdAt        DateTime  @default(now())
  expiresAt        DateTime  // 7 days default

  vendor           Organization @relation("VendorContentOpportunities", fields: [vendorId], references: [id], onDelete: Cascade)
  product          Product      @relation("ProductContentOpportunities", fields: [productId], references: [id], onDelete: Cascade)

  @@index([vendorId, status])
  @@index([productId])
  @@index([status, expiresAt])
  @@map("vendor_content_opportunities")
}

// ============================================================================
// CONTRIBUTOR/VOICE SYSTEM
// See: Implementation spec for contributor voice gathering
// ============================================================================

enum ArticleTopicStatus {
  QUEUED          // In admin queue, not visible to users yet
  GATHERING       // Actively collecting contributions
  THRESHOLD_MET   // Min reached, can move to writing
  WRITING         // Being written/edited
  REVIEW          // Editorial review
  PUBLISHED       // Live
  ARCHIVED        // Closed without publishing
}

enum ContributionType {
  QUICK_TAKE        // 2-3 sentences
  EXPERTISE         // Rep product knowledge
  PREDICTION        // Future trend take
  REFLECTION        // Project reflection
  ENDORSEMENT       // Product endorsement
  CONSUMER_VOICE    // Individual perspective
}

enum ContributionStatus {
  PENDING           // Awaiting review
  APPROVED          // Approved for use
  SELECTED          // Selected for article
  PUBLISHED         // Live in article
  REJECTED          // Not usable
}

enum BadgeLevel {
  VOICE             // 1 published
  PERSPECTIVE       // 5 published (Designer)
  SPECIALIST        // 5 published (Rep)
  ENGAGED           // 5 published (Individual)
  AUTHORITY         // 15 published
  EDITORIAL_VOICE   // 30+ published
}

enum PromptLocation {
  MAGAZINE_PAGE
  FOR_YOU_FEED
  POST_SAVE
  POST_PUBLISH
  WELCOME_BACK
  PRODUCT_PAGE
  PROJECT_DETAIL
  PROFILE_DASHBOARD
}

// Article Topic Queue - Admin-managed pipeline for upcoming articles
model ArticleTopic {
  id                  String   @id @default(cuid())

  // Topic definition
  title               String   // "The Quiet Return of Travertine"
  slug                String   @unique
  promptQuestion      String   @db.Text // "What draws you to travertine right now?"
  description         String?  @db.Text // Internal admin notes

  // Categorization
  category            String   // 'material', 'trend', 'philosophy', 'vendor', 'regional'
  tags                String[] // ['stone', 'natural', 'warm-tones']

  // Targeting - who sees this prompt
  targetRoles         String[] // ['DESIGNER', 'VENDOR', 'INDIVIDUAL']
  targetMaterials     String[] // Material categories that trigger visibility
  targetStyles        String[] // Style categories
  minSaveCount        Int?     // User must have X saves in related category

  // Thresholds for progression
  minContributions    Int      @default(5)
  targetContributions Int      @default(15)
  minDesigners        Int      @default(3)
  minReps             Int?
  minIndividuals      Int?

  // Status
  status              ArticleTopicStatus @default(QUEUED)

  // Auto-trigger from trends
  autoTriggered       Boolean  @default(false)
  triggerSignalId     String?
  triggerSignal       TrendSignal? @relation("TrendGeneratedTopics", fields: [triggerSignalId], references: [id])

  // Timing
  queuedAt            DateTime @default(now())
  gatheringStartedAt  DateTime?
  writingStartedAt    DateTime?
  publishedAt         DateTime?
  targetPublishDate   DateTime?

  // Relations
  contributions       Contribution[]
  prompts             ContributionPrompt[]

  // When published, links to the article
  publishedPostId     String?  @unique
  publishedPost       ProjectPost? @relation("TopicPublishedPost", fields: [publishedPostId], references: [id])

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([status])
  @@index([category])
  @@map("article_topics")
}

// Universal voice capture - works for all user types
model Contribution {
  id                String   @id @default(cuid())

  // Who contributed
  userId            String
  user              User     @relation("UserContributions", fields: [userId], references: [id], onDelete: Cascade)
  userRole          String   // Role at time of contribution

  // What topic
  articleTopicId    String
  articleTopic      ArticleTopic @relation(fields: [articleTopicId], references: [id], onDelete: Cascade)

  // Optional context anchors
  productId         String?  // If about specific product
  product           Product? @relation("ProductContributions", fields: [productId], references: [id])
  projectId         String?  // If reflecting on project
  project           Project? @relation("ProjectContributions", fields: [projectId], references: [id])
  saveId            String?  // If prompted after save

  // The contribution
  type              ContributionType
  content           String   @db.Text

  // Voice support (reuse existing pattern)
  audioUrl          String?
  voiceTranscript   String?  @db.Text

  // Editorial processing
  status            ContributionStatus @default(PENDING)
  editedContent     String?  @db.Text
  pullQuote         String?

  // Publishing
  publishedInPostId String?
  publishedInPost   ProjectPost? @relation("PostContributions", fields: [publishedInPostId], references: [id])
  displayOrder      Int?

  // Share card
  shareCardUrl      String?
  shareCardGeneratedAt DateTime?
  shareCount        Int      @default(0)

  // Share card relation
  shareCard         ShareCard?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([userId, articleTopicId])
  @@index([articleTopicId, status])
  @@index([userId])
  @@index([userRole])
  @@map("contributions")
}

// Contributor recognition badges
model ContributorBadge {
  id                String     @id @default(cuid())
  userId            String
  user              User       @relation("UserContributorBadges", fields: [userId], references: [id], onDelete: Cascade)

  level             BadgeLevel
  earnedAt          DateTime   @default(now())
  publishedCount    Int
  totalContributions Int

  @@unique([userId, level])
  @@map("contributor_badges")
}

// Contextual prompts for where/when to show contribution opportunities
model ContributionPrompt {
  id                String   @id @default(cuid())

  location          PromptLocation

  // Targeting
  targetRoles       String[]
  targetMaterials   String[]
  targetStyles      String[]
  minSaveCount      Int?
  minDaysActive     Int?

  // Link to topic
  articleTopicId    String
  articleTopic      ArticleTopic @relation(fields: [articleTopicId], references: [id])
  customQuestion    String?  // Override default

  // Display
  priority          Int      @default(0)
  active            Boolean  @default(true)
  maxImpressions    Int?
  impressionCount   Int      @default(0)

  createdAt         DateTime @default(now())

  @@index([location, active])
  @@map("contribution_prompts")
}

// Share cards for social sharing
model ShareCard {
  id                String   @id @default(cuid())

  contributionId    String?  @unique
  contribution      Contribution? @relation(fields: [contributionId], references: [id])
  projectPostId     String?

  imageUrl          String
  quote             String   @db.Text
  attribution       String
  articleTitle      String
  articleUrl        String
  variant           String   @default("instagram")

  generatedAt       DateTime @default(now())

  @@map("share_cards")
}

// ============================================================
// DESIGNER SHOP SYSTEM
// Products curated by designers with testimonials and vendor boosts
// ============================================================

model ShopProduct {
  id              String    @id @default(cuid())
  designerId      String
  productId       String
  projectId       String?   // Source project where product was tagged
  quote           String?   // Designer testimonial
  quoteApprovedAt DateTime? // When quote was approved/added
  isActive        Boolean   @default(true)
  isFeatured      Boolean   @default(false) // Designer-pinned to top
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  designer        User      @relation("DesignerShopProducts", fields: [designerId], references: [id], onDelete: Cascade)
  product         Product   @relation("ProductShopProducts", fields: [productId], references: [id], onDelete: Cascade)
  project         Project?  @relation("ProjectShopProducts", fields: [projectId], references: [id], onDelete: SetNull)
  boosts          ShopBoost[]
  testimonial     ProductTestimonial?

  @@unique([designerId, productId])
  @@index([designerId])
  @@index([productId])
  @@map("shop_products")
}

model ShopBoost {
  id              String          @id @default(cuid())
  shopProductId   String
  vendorId        String          // Organization ID
  status          ShopBoostStatus @default(PENDING)
  startDate       DateTime
  endDate         DateTime
  amountPaid      Decimal         @db.Decimal(10, 2)
  designerCredit  Decimal         @db.Decimal(10, 2) // 70% share
  folioRevenue    Decimal         @db.Decimal(10, 2) // 30% share
  approvedAt      DateTime?
  declinedAt      DateTime?
  declineReason   String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  // Relations
  shopProduct     ShopProduct     @relation(fields: [shopProductId], references: [id], onDelete: Cascade)
  vendor          Organization    @relation("VendorShopBoosts", fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([shopProductId])
  @@index([vendorId])
  @@index([status])
  @@map("shop_boosts")
}

model ProductTestimonial {
  id              String      @id @default(cuid())
  productId       String
  shopProductId   String      @unique
  quote           String
  isFeatured      Boolean     @default(false) // Vendor-boosted
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  // Relations
  product         Product     @relation("ProductTestimonials", fields: [productId], references: [id], onDelete: Cascade)
  shopProduct     ShopProduct @relation(fields: [shopProductId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_testimonials")
}

// ─── Vendor Invite & Presentation System ────────────────────────────────────

// Track vendor notification/claim status when designers tag vendor products
model VendorInvite {
  id                String       @id @default(cuid())
  organizationId    String       @unique
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Trigger tag (the tag that initiated the invite)
  triggerTagId      String?
  triggerTag        ProductTag?  @relation("VendorInviteTriggerTag", fields: [triggerTagId], references: [id], onDelete: SetNull)

  // Invite tracking
  emailSentAt       DateTime?
  emailOpenedAt     DateTime?
  linkClickedAt     DateTime?

  // Claim tracking
  claimedAt         DateTime?
  claimedByUserId   String?
  claimedByUser     User?        @relation("VendorInvitesClaimed", fields: [claimedByUserId], references: [id], onDelete: SetNull)

  // Admin activation
  adminActivatedAt  DateTime?
  adminUserId       String?
  adminUser         User?        @relation("VendorInvitesAdmin", fields: [adminUserId], references: [id], onDelete: SetNull)

  // Founding vendor program
  foundingVendorSlot Int?        // null = not in program, 1-20 = slot number

  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([claimedByUserId])
  @@index([adminUserId])
  @@map("vendor_invites")
}

// Track presentation scroll analytics
model VendorPresentationView {
  id                String       @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  userId            String?
  user              User?        @relation("VendorPresentationViews", fields: [userId], references: [id], onDelete: SetNull)

  presentationType  String       // "rep" or "admin"

  // Scroll analytics
  maxScrollDepth    Float        @default(0)  // 0-1 percentage
  sectionsViewed    String[]     // ["hook", "what-happened", ...]
  timeOnPageMs      Int          @default(0)

  // CTA tracking
  ctaClicked        String?      // which CTA was clicked

  viewToken         String       @unique @default(cuid())

  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([organizationId])
  @@index([userId])
  @@map("vendor_presentation_views")
}
