  ROOM_TYPE
  MATERIAL
  VENDOR
  PRODUCT_CATEGORY
  COLOR_CLUSTER
  BEHAVIOR
}

enum AtelierRelationType {
  PROJECT_ROOM_FOCUS
  FREQUENT_VENDOR
  PREFERS
  STYLE_MATERIAL
  STYLE_COLOR
}

enum AtelierSignalSourceType {
  PROJECT
  SELECTION
  SAVE
  TAG
  INTERVIEW
  BEHAVIOR
}

model AtelierFingerprint {
  id             String           @id @default(cuid())
  ownerType      AtelierOwnerType
  designerId     String?
  vendorId       String?
  completeness   Float            @default(0)
  lastComputedAt DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  // Versioning for consultation attribution
  version        Int              @default(1)
  snapshot       Json?            // Computed fingerprint snapshot for deployments

  nodes AtelierNode[]
  edges AtelierEdge[]

  // Deployment relations
  deployments    AtelierDeployment[]

  @@index([ownerType, designerId])
  @@index([ownerType, vendorId])
  @@map("atelier_fingerprints")
}

model AtelierNode {
  id            String            @id @default(cuid())
  fingerprintId String
  nodeType      AtelierNodeType
  label         String
  weight        Float             @default(0)
  metadata      Json?
  createdAt     DateTime          @default(now())

  fingerprint   AtelierFingerprint @relation(fields: [fingerprintId], references: [id], onDelete: Cascade)
  sourceEdges   AtelierEdge[]      @relation("SourceNode")
  targetEdges   AtelierEdge[]      @relation("TargetNode")

  @@index([fingerprintId, nodeType])
  @@map("atelier_nodes")
}

model AtelierEdge {
  id            String              @id @default(cuid())
  fingerprintId String
  sourceNodeId  String
  targetNodeId  String
  relationType  AtelierRelationType
  weight        Float               @default(0)
  createdAt     DateTime            @default(now())

  fingerprint AtelierFingerprint @relation(fields: [fingerprintId], references: [id], onDelete: Cascade)
  sourceNode  AtelierNode        @relation("SourceNode", fields: [sourceNodeId], references: [id], onDelete: Cascade)
  targetNode  AtelierNode        @relation("TargetNode", fields: [targetNodeId], references: [id], onDelete: Cascade)

  @@index([fingerprintId])
  @@index([sourceNodeId])
  @@index([targetNodeId])
  @@map("atelier_edges")
}

model AtelierSignal {
  id         String                  @id @default(cuid())
  ownerType  AtelierOwnerType
  designerId String?
  vendorId   String?
  sourceType AtelierSignalSourceType
  sourceId   String?
  key        String
  weight     Float                   @default(1)
  metadata   Json?
  createdAt  DateTime                @default(now())

  @@index([ownerType, designerId])
  @@index([ownerType, vendorId])
  @@index([key])
  @@map("atelier_signals")
}

model ImpersonationLog {
  id           String    @id @default(cuid())
  adminId      String
  targetUserId String
  startedAt    DateTime  @default(now())
  endedAt      DateTime?
  admin        User      @relation("AdminImpersonations", fields: [adminId], references: [id])
  targetUser   User      @relation("UserImpersonations", fields: [targetUserId], references: [id])

  @@index([adminId])
  @@index([targetUserId])
  @@map("impersonation_logs")
}

// ============================================================
// IMPORT AGENT - AI-powered project import from presentations
// ============================================================

model ImportSession {
  id            String   @id @default(uuid())
  userId        String

  sourceType    ImportSourceType  // PRESENTATION, WEBSITE, BULK_IMAGES
  sourceUrl     String?           // Original URL if website import
  fileName      String?           // Original filename if upload

  status        ImportSessionStatus @default(PROCESSING)
  // PROCESSING → ANALYZED → READY_FOR_REVIEW → COMPLETED → FAILED

  projectId     String?           // Created/target project

  // Metrics
  totalImages   Int      @default(0)
  totalProducts Int      @default(0)
  verifiedTags  Int      @default(0)

  // Processing metadata
  processingMeta Json?   // Agent state, partial results
  errorMessage   String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  completedAt   DateTime?

  pendingTags   PendingProductTag[]

  @@index([userId])
  @@index([status])
  @@map("import_sessions")
}

model PendingProductTag {
  id              String   @id @default(uuid())
  importSessionId String
  importSession   ImportSession @relation(fields: [importSessionId], references: [id], onDelete: Cascade)

  // Image reference
  projectImageId  String?
  tempImageUrl    String?      // Before project image is created

  // Position on image
  x               Float
  y               Float

  // Agent's detection
  description     String       // "Navy velvet sofa with brass legs"
  category        String       // FURNITURE, LIGHTING, etc.
  searchQuery     String       // Query used for attribution

  // Agent's attribution suggestions
  suggestions     Json         // Array of ProductAttribution objects
  topSuggestion   Json?        // Best match for quick display

  // Confidence
  detectionConfidence   String  // high, medium, low
  attributionConfidence String? // high, medium, low (after search)

  // Room type detected from image analysis
  roomType        String?

  // Extracted spec data from PDF text (populated when PDF has text annotations)
  extractedVendor     String?      // Brand/vendor name from text
  extractedPrice      Int?         // Price in cents
  extractedDimensions String?      // Dimensions string (e.g., "72W x 36D x 30H")
  extractedSku        String?      // SKU or model number
  extractedMaterial   String?      // Material description
  extractedProductUrl String?      // Product URL if found

  // Verification status
  status          PendingTagStatus @default(UNREVIEWED)
  // UNREVIEWED → CONFIRMED → CORRECTED → DISMISSED

  // If confirmed/corrected, link to actual product
  confirmedProductId String?

  // If corrected, what did designer change?
  correctionNote     String?

  // Resulting ProductTag (after confirmation)
  resultingTagId     String?   @unique

  createdAt       DateTime @default(now())
  reviewedAt      DateTime?

  @@index([importSessionId, status])
  @@index([status])
  @@map("pending_product_tags")
}

enum ImportSourceType {
  PRESENTATION
  WEBSITE
  BULK_IMAGES
}

enum ImportSessionStatus {
  PROCESSING
  ANALYZED
  READY_FOR_REVIEW
  COMPLETED
  FAILED
}

enum PendingTagStatus {
  UNREVIEWED
  CONFIRMED
  CORRECTED
  DISMISSED
}

