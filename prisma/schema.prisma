// ─── Pending Actions (queued requests for invited reps) ───────────

model PendingAction {
  id           String              @id @default(cuid())
  senderId     String
  actionType   MessageCategory
  productId    String
  targetEmail  String
  targetName   String
  targetOrgId  String?
  payload      Json
  status       PendingActionStatus @default(PENDING)
  inviteSentAt   DateTime?
  reminderSentAt DateTime?
  deliveredAt    DateTime?
  expiredAt      DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sender  User    @relation("UserPendingActions", fields: [senderId], references: [id], onDelete: Cascade)
  product Product @relation("ProductPendingActions", fields: [productId], references: [id], onDelete: Cascade)

  @@index([targetEmail])
  @@index([status])
  @@index([senderId])
  @@map("pending_actions")
}

// ─── Phase 3: Project-Level Actions ───────────────────────────────

model ProjectProductPricing {
  id              String    @id @default(cuid())
  projectId       String
  productId       String
  roomId          String?

  // Pricing
  unitPriceTrade  Decimal?  @db.Decimal(10, 2)
  unitPriceRetail Decimal?  @db.Decimal(10, 2)
  quantity        Int       @default(1)
  unit            String?

  // Quote metadata
  quotedById      String?
  quotedByName    String?
  quotedByEmail   String?
  quotedAt        DateTime?
  validThrough    DateTime?
  quoteSource     String    @default("MANUAL")

  // Lead time
  leadTimeWeeks   Int?
  availability    String?
  availabilityNote String?

  // COM/COL
  isCustomMaterial Boolean  @default(false)
  comVendor       String?
  comMaterial      String?
  comSku           String?
  comYardage       Decimal?  @db.Decimal(10, 2)

  // Status
  status          String    @default("NOT_REQUESTED")

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  product         Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  quotedBy        User?     @relation("QuotedByUser", fields: [quotedById], references: [id], onDelete: SetNull)

  @@unique([projectId, productId, roomId])
  @@index([projectId])
  @@index([productId])
  @@index([status])
  @@map("project_product_pricing")
}

model BulkPricingRequest {
  id              String    @id @default(cuid())
  projectId       String
  vendorOrgId     String?
  vendorName      String
  repId           String?
  repName         String?
  repEmail        String?

  productIds      String[]  @default([])
  timeline        String?
  designerNote    String?
  tradeStatus     String?

  status          String    @default("SENT")
  sentAt          DateTime  @default(now())
  respondedAt     DateTime?
  conversationId  String?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  project         Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  vendorOrg       Organization? @relation("VendorBulkRequests", fields: [vendorOrgId], references: [id], onDelete: SetNull)
  rep             User?         @relation("BulkRequestRep", fields: [repId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([vendorOrgId])
  @@index([status])
  @@map("bulk_pricing_requests")
}

model ActionItemSignal {
  id              String    @id @default(cuid())
  actionType      String
  productId       String
  vendorOrgId     String?
  projectId       String?
  designerOrgId   String

  quantity        Int?
  unit            String?
  timeline        String?
  projectType     String?
  location        String?

  resolution      String    @default("PENDING")
  responseTime    Int?
  convertedToOrder Boolean  @default(false)

  isOffPlatform   Boolean   @default(false)
  isBulk          Boolean   @default(false)

  createdAt       DateTime  @default(now())

  product         Product       @relation("ProductActionSignals", fields: [productId], references: [id], onDelete: Cascade)
  vendorOrg       Organization? @relation("VendorActionSignals", fields: [vendorOrgId], references: [id], onDelete: SetNull)
  designerOrg     Organization  @relation("DesignerActionSignals", fields: [designerOrgId], references: [id], onDelete: Cascade)

  @@index([actionType])
  @@index([productId])
  @@index([vendorOrgId])
  @@index([designerOrgId])
  @@index([createdAt])
  @@index([projectType])
  @@map("action_item_signals")
}

// ─── Phase 4: Shadow Profiles ─────────────────────────────────────

model VendorShadowProfile {
  id               String    @id @default(cuid())
  vendorName       String    @unique
  vendorOrgId      String?   @unique

  totalProducts    Int       @default(0)
  totalProjects    Int       @default(0)
  totalDesigners   Int       @default(0)
  totalQuotedValue Decimal?  @db.Decimal(10, 2)
  avgOrderValue    Decimal?  @db.Decimal(10, 2)
  reorderRate      Float?

  geoDistribution  Json?
  projectTypeDist  Json?
  topProducts      Json?

  claimedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  vendorOrg        Organization? @relation("VendorShadowOrg", fields: [vendorOrgId], references: [id], onDelete: SetNull)
  reps             RepShadowProfile[]

  @@index([vendorOrgId])
  @@map("vendor_shadow_profiles")
}

model RepShadowProfile {
  id                  String    @id @default(cuid())
  vendorShadowId      String
  repName             String
  repEmail            String?
  userId              String?   @unique

  inferredTerritory   String?

  designersServed     Int       @default(0)
  totalRequests       Int       @default(0)
  avgResponseHours    Float?
  quoteConversionRate Float?
  repeatRequestRate   Float?

  claimedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  vendorShadow        VendorShadowProfile @relation(fields: [vendorShadowId], references: [id], onDelete: Cascade)
  user                User?               @relation("RepShadowUser", fields: [userId], references: [id], onDelete: SetNull)
  designerContacts    DesignerContact[]   @relation("RepShadowContacts")

  @@unique([vendorShadowId, repEmail])
  @@index([vendorShadowId])
  @@index([userId])
  @@map("rep_shadow_profiles")
}

// ─── Phase 5: Email Integration ──────────────────────────────────

model ProxyAddress {
  id        String   @id @default(cuid())
  userId    String   @unique
  address   String   @unique

  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("proxy_addresses")
}

model EmailThread {
  id              String            @id @default(cuid())
  userId          String
  conversationId  String?           @unique

  // Linkage to action
  actionType      String?
  productId       String?
  projectId       String?
  pendingActionId String?

  // Recipient
  recipientEmail  String
  recipientName   String?
  vendorOrgId     String?

  // Thread state
  status          EmailThreadStatus @default(SENT)
  subject         String

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  user            User              @relation("UserEmailThreads", fields: [userId], references: [id], onDelete: Cascade)
  conversation    Conversation?     @relation("EmailThreadConversation", fields: [conversationId], references: [id], onDelete: SetNull)
  messages        EmailMessage[]

  @@index([userId])
  @@index([recipientEmail])
  @@index([status])
  @@map("email_threads")
}

model EmailMessage {
  id              String          @id @default(cuid())
  threadId        String
  direction       EmailDirection

  // Email fields
  fromAddress     String
  toAddress       String
  subject         String
  textBody        String
  htmlBody        String?

  // Resend metadata
  resendMessageId String?
  inboundId       String?

  // Parsing (for inbound replies)
  parsedData      Json?
  parsingStatus   ParsingStatus?

  sentAt          DateTime
  createdAt       DateTime        @default(now())

  thread          EmailThread     @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId])
  @@index([resendMessageId])
  @@map("email_messages")
}

enum EmailThreadStatus {
  SENT
  REPLIED
  PARSED
  CONFIRMED
  CLOSED
}

enum EmailDirection {
  OUTBOUND
  INBOUND
}

enum ParsingStatus {
  PENDING
  PARSED
  CONFIRMED
  REJECTED
}

// ─── Phase 5: Contact Import ─────────────────────────────────────

model DesignerContact {
  id              String                  @id @default(cuid())
  userId          String
  importSourceId  String

  // Contact fields
  name            String
  email           String
  company         String?
  title           String?

  // Matching
  vendorOrgId     String?
  vendorName      String?
  matchConfidence ContactMatchConfidence?
  isPreferredRep  Boolean                 @default(false)

  // Shadow profile linkage
  repShadowId     String?

  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  user            User                    @relation("UserDesignerContacts", fields: [userId], references: [id], onDelete: Cascade)
  importSource    ContactImportJob        @relation(fields: [importSourceId], references: [id], onDelete: Cascade)
  vendorOrg       Organization?           @relation("VendorOrgDesignerContacts", fields: [vendorOrgId], references: [id], onDelete: SetNull)
  repShadow       RepShadowProfile?       @relation("RepShadowContacts", fields: [repShadowId], references: [id], onDelete: SetNull)

  @@unique([userId, email])
  @@index([userId])
  @@index([vendorOrgId])
  @@index([email])
  @@map("designer_contacts")
}

model ContactImportJob {
  id              String        @id @default(cuid())
  userId          String
  source          ContactSource

  // Processing status
  status          ImportStatus  @default(PROCESSING)
  totalContacts   Int           @default(0)
  filteredCount   Int           @default(0)
  matchedCount    Int           @default(0)
  importedCount   Int           @default(0)

  // OAuth metadata (if applicable)
  oauthProvider   String?
  syncToken       String?

  processedAt     DateTime?
  createdAt       DateTime      @default(now())

  user            User          @relation("UserContactImportJobs", fields: [userId], references: [id], onDelete: Cascade)
  contacts        DesignerContact[]

  @@index([userId])
  @@map("contact_import_jobs")
}

enum ContactMatchConfidence {
  HIGH
  MEDIUM
  LOW
  UNMATCHED
}

enum ContactSource {
  GOOGLE
  MICROSOFT
  CSV_UPLOAD
  VCF_UPLOAD
}

enum ImportStatus {
  PROCESSING
  AWAITING_REVIEW
  COMPLETED
  FAILED
}
