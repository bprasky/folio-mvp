  repSeatLimit Int  @default(1)

  // Billing
  stripeCustomerId     String?
  stripeSubscriptionId String?
  billingEmail         String?

  // Status
  status             VendorSubscriptionStatus @default(ACTIVE)
  trialEndsAt        DateTime?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  canceledAt         DateTime?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("vendor_subscriptions")
}

model CollaborationStory {
  id   String @id @default(cuid())
  slug String @unique

  // Participants
  vendorOrgId    String
  designerUserId String

  // Status
  status CollaborationStoryStatus @default(INVITED)

  // Interview data (JSON for flexibility)
  vendorRound1   Json?
  vendorRound2   Json?
  vendorRound3   Json?
  designerRound1 Json?
  designerRound2 Json?
  designerRound3 Json?

  // Generated content
  generatedNarrative Json?
  finalContent       Json? // expandedBlocks format

  // Metadata
  title        String?
  excerpt      String?
  heroImageUrl String?

  // Tagged content
  taggedProductIds String[]
  taggedProjectId  String? // Optional reference project

  // Timestamps
  invitedAt           DateTime  @default(now())
  acceptedAt          DateTime?
  vendorCompletedAt   DateTime?
  designerCompletedAt DateTime?
  publishedAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Relations
  vendorOrg Organization @relation("CollaborationStoryVendor", fields: [vendorOrgId], references: [id])
  designer  User         @relation("CollaborationStoryDesigner", fields: [designerUserId], references: [id])

