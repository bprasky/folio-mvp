  BUILDER // NEW - for construction/builder participants
}

enum ParticipantRole {
  OWNER
  EDITOR
  VIEWER
}

enum PostStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}

enum PostVariant {
  PROJECT_FEATURE
  MATERIAL_STUDY
  METHOD
  DESIGNER_PROFILE
  EVENT_ESSAY
  PROMPTED_ARTICLE
}

model ProjectPost {
  id        String  @id @default(cuid())
  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  status      PostStatus  @default(DRAFT)
  variant     PostVariant @default(PROJECT_FEATURE)
  slug        String      @unique
  heroAssetId String?
  excerpt     String?
  keywords    String[]    @default([])

  expandedBlocks Json?
  provenance     Json?
  credits        Json?

  publishedAt          DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  editorialAssignments EditorialAssignment[]

  // Intelligence System relations
  supplementalQuotes SupplementalQuote[] @relation("PostSupplementalQuotes")

  // In Context Boost System
  inContextBoosts InContextBoost[] @relation("PostInContextBoosts")

  // Contributor/Voice System relations
  publishedContributions Contribution[] @relation("PostContributions")
  sourceArticleTopic     ArticleTopic?  @relation("TopicPublishedPost")

  // Prompted Content: Story Threads
  storyThreads           StoryThread[]

  // Section editing (Phase C)
  sectionOverrides   Json?    @map("section_overrides")
  sectionHistory     Json?    @map("section_history")
  lastGenerationNote String?  @map("last_generation_note") @db.Text

  postSaves              PostSave[]

  @@map("project_posts")
}

enum ProjectModuleType {
  ARTICLE
  STORY
  SHORT_VIDEO
  LONG_VIDEO
  GALLERY
  BOARD
  TIMELINE
}

model ProjectModule {
  id          String  @id @default(cuid())
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String
  createdBy   User?   @relation(fields: [createdById], references: [id])
  createdById String?

  type        ProjectModuleType
  title       String?
  description String?

  // Media is intentionally flexible; we can store file ids, URLs, or embeds.
  media Json? // e.g. [{ kind: "video", url, provider }, { kind: "image", url, caption }]

  pinned       Boolean @default(false) // surface at top of project page
  isPrimary    Boolean @default(false) // e.g. the canonical long-form film
  isAiCompiled Boolean @default(false) // future: AI-compiled film vs manual upload

  publishedAt DateTime? // null = draft
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([projectId, type, publishedAt])
  @@index([createdById])
  @@map("project_modules")
}

model EditorialCategory {
