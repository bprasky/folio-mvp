model Embedding {
  id        String   @id @default(cuid())
  nodeType  String
  nodeId    String
  vector    Bytes
  updatedAt DateTime @default(now())

  @@unique([nodeType, nodeId])
  @@index([nodeType])
  @@map("embeddings")
}

model GraphEdge {
  id        String   @id @default(cuid())
  srcType   String
  srcId     String
  dstType   String
  dstId     String
  kind      String // "uses" | "saves" | "includes" | "attends" | "hosts" | "associated_with" | "affinity"
