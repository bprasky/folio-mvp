  INDIVIDUAL
}

// ============================================================
// COLLABORATION STORIES - Dual-interview content type
// ============================================================

enum CollaborationStoryStatus {
  INVITED
  DECLINED
  ACCEPTED
  ROUND1_VENDOR
  ROUND1_DESIGNER
  ROUND1_COMPLETE
  ROUND2_VENDOR
  ROUND2_DESIGNER
  ROUND2_COMPLETE
  ROUND3_VENDOR
  ROUND3_DESIGNER
  ROUND3_COMPLETE
  GENERATING
  REVIEW
  VENDOR_APPROVED
  DESIGNER_APPROVED
  PUBLISHED
  ARCHIVED
}

enum VendorTier {
  STARTER
  GROWTH
  PROFESSIONAL
  ENTERPRISE
}

enum VendorSubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  PAUSED
}

model VendorSubscription {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  tier VendorTier @default(STARTER)

