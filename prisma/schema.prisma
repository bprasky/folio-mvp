// ============================================================
// ATELIER - Designer/Vendor Fingerprint System
// ============================================================

enum AtelierOwnerType {
  DESIGNER
  VENDOR
}

enum AtelierNodeType {
  STYLE
  ROOM_TYPE
  MATERIAL
  VENDOR
  PRODUCT_CATEGORY
  COLOR_CLUSTER
  BEHAVIOR
}

enum AtelierRelationType {
  PROJECT_ROOM_FOCUS
  FREQUENT_VENDOR
  PREFERS
  STYLE_MATERIAL
  STYLE_COLOR
}

enum AtelierSignalSourceType {
  PROJECT
  SELECTION
  SAVE
  TAG
  INTERVIEW
  BEHAVIOR
}

model AtelierFingerprint {
  id             String           @id @default(cuid())
  ownerType      AtelierOwnerType
  designerId     String?
  vendorId       String?
  completeness   Float            @default(0)
  lastComputedAt DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  nodes AtelierNode[]
  edges AtelierEdge[]

  @@index([ownerType, designerId])
  @@index([ownerType, vendorId])
  @@map("atelier_fingerprints")
}

model AtelierNode {
  id            String            @id @default(cuid())
  fingerprintId String
  nodeType      AtelierNodeType
  label         String
  weight        Float             @default(0)
  metadata      Json?
  createdAt     DateTime          @default(now())

  fingerprint   AtelierFingerprint @relation(fields: [fingerprintId], references: [id], onDelete: Cascade)
  sourceEdges   AtelierEdge[]      @relation("SourceNode")
  targetEdges   AtelierEdge[]      @relation("TargetNode")

  @@index([fingerprintId, nodeType])
  @@map("atelier_nodes")
}

model AtelierEdge {
  id            String              @id @default(cuid())
  fingerprintId String
  sourceNodeId  String
  targetNodeId  String
  relationType  AtelierRelationType
  weight        Float               @default(0)
  createdAt     DateTime            @default(now())

  fingerprint AtelierFingerprint @relation(fields: [fingerprintId], references: [id], onDelete: Cascade)
  sourceNode  AtelierNode        @relation("SourceNode", fields: [sourceNodeId], references: [id], onDelete: Cascade)
  targetNode  AtelierNode        @relation("TargetNode", fields: [targetNodeId], references: [id], onDelete: Cascade)

  @@index([fingerprintId])
  @@index([sourceNodeId])
  @@index([targetNodeId])
  @@map("atelier_edges")
}

model AtelierSignal {
  id         String                  @id @default(cuid())
  ownerType  AtelierOwnerType
  designerId String?
  vendorId   String?
  sourceType AtelierSignalSourceType
  sourceId   String?
  key        String
  weight     Float                   @default(1)
  metadata   Json?
  createdAt  DateTime                @default(now())

  @@index([ownerType, designerId])
  @@index([ownerType, vendorId])
  @@index([key])
  @@map("atelier_signals")
model ImpersonationLog {
  id           String    @id @default(cuid())
  adminId      String
  targetUserId String
  startedAt    DateTime  @default(now())
  endedAt      DateTime?
  admin        User      @relation("AdminImpersonations", fields: [adminId], references: [id])
  targetUser   User      @relation("UserImpersonations", fields: [targetUserId], references: [id])

  @@index([adminId])
  @@index([targetUserId])
  @@map("impersonation_logs")
}

// ============================================================
// IMPORT AGENT - AI-powered project import from presentations
// ============================================================

model ImportSession {
  id            String   @id @default(uuid())
  userId        String

  sourceType    ImportSourceType  // PRESENTATION, WEBSITE, BULK_IMAGES
  sourceUrl     String?           // Original URL if website import
  fileName      String?           // Original filename if upload

  status        ImportSessionStatus @default(PROCESSING)
  // PROCESSING → ANALYZED → READY_FOR_REVIEW → COMPLETED → FAILED

  projectId     String?           // Created/target project

  // Metrics
  totalImages   Int      @default(0)
  totalProducts Int      @default(0)
  verifiedTags  Int      @default(0)

  // Processing metadata
  processingMeta Json?   // Agent state, partial results
  errorMessage   String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  completedAt   DateTime?

  pendingTags   PendingProductTag[]

  @@index([userId])
  @@index([status])
  @@map("import_sessions")
}

model PendingProductTag {
  id              String   @id @default(uuid())
  importSessionId String
  importSession   ImportSession @relation(fields: [importSessionId], references: [id], onDelete: Cascade)

  // Image reference
  projectImageId  String?
  tempImageUrl    String?      // Before project image is created

  // Position on image
  x               Float
  y               Float

  // Agent's detection
  description     String       // "Navy velvet sofa with brass legs"
  category        String       // FURNITURE, LIGHTING, etc.
  searchQuery     String       // Query used for attribution

  // Agent's attribution suggestions
  suggestions     Json         // Array of ProductAttribution objects
  topSuggestion   Json?        // Best match for quick display

  // Confidence
  detectionConfidence   String  // high, medium, low
  attributionConfidence String? // high, medium, low (after search)

  // Verification status
  status          PendingTagStatus @default(UNREVIEWED)
  // UNREVIEWED → CONFIRMED → CORRECTED → DISMISSED

  // If confirmed/corrected, link to actual product
  confirmedProductId String?

  // If corrected, what did designer change?
  correctionNote     String?

  // Resulting ProductTag (after confirmation)
  resultingTagId     String?   @unique

  createdAt       DateTime @default(now())
  reviewedAt      DateTime?

  @@index([importSessionId, status])
  @@index([status])
  @@map("pending_product_tags")
}

enum ImportSourceType {
  PRESENTATION
  WEBSITE
  BULK_IMAGES
}

enum ImportSessionStatus {
  PROCESSING
  ANALYZED
  READY_FOR_REVIEW
  COMPLETED
  FAILED
}

enum PendingTagStatus {
  UNREVIEWED
  CONFIRMED
  CORRECTED
  DISMISSED
}

// ============================================================
// WAITLIST - Email capture for Vendor/Individual signups
// ============================================================

model WaitlistSignup {
  id        String       @id @default(cuid())
  email     String
  type      WaitlistType
  createdAt DateTime     @default(now())

  @@unique([email, type])
  @@map("waitlist_signups")
}

enum WaitlistType {
  VENDOR
  INDIVIDUAL
}

// ============================================================
// COMMERCE & CREDIT SYSTEM - Phase 1B
// ============================================================

enum CreditTransactionType {
  EARN
  REDEEM
  EXPIRE
  ADJUSTMENT
}

enum CreditSourceType {
  DESIGNER_COMMISSION
  REP_ATTRIBUTION
  BONUS
  ADJUSTMENT
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  COMPLETED
  CANCELLED
  RETURNED
}

enum FulfillmentMethod {
  TRADE_LOGIN
  QUOTE
  REP_MEDIATED
  API
  MANUAL
}

enum TradeAccountType {
  TRADE_LOGIN
  QUOTE
  REP_MEDIATED
  API
}

model CreditAccount {
  id                String    @id @default(cuid())
  userId            String    @unique
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  availableBalance  Decimal   @default(0) @db.Decimal(12, 2)
  pendingBalance    Decimal   @default(0) @db.Decimal(12, 2)
  lifetimeEarned    Decimal   @default(0) @db.Decimal(12, 2)
  lifetimeRedeemed  Decimal   @default(0) @db.Decimal(12, 2)

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  transactions      CreditTransaction[]

  @@map("credit_accounts")
}

model CreditTransaction {
  id              String                @id @default(cuid())
  accountId       String
  account         CreditAccount         @relation(fields: [accountId], references: [id], onDelete: Cascade)

  type            CreditTransactionType
  amount          Decimal               @db.Decimal(12, 2)

  // Source tracking for EARN
  sourceType      CreditSourceType?
  sourceOrderId   String?
  sourceOrder     Order?                @relation("EarnedFromOrder", fields: [sourceOrderId], references: [id])

  // Redemption tracking for REDEEM
  redemptionOrderId String?
  redemptionOrder   Order?              @relation("RedeemedOnOrder", fields: [redemptionOrderId], references: [id])

  // Hold period management
  availableAt     DateTime              @default(now())

  description     String?
  createdAt       DateTime              @default(now())

  @@index([accountId, createdAt])
  @@index([availableAt])
  @@map("credit_transactions")
}

model Order {
  id                    String      @id @default(cuid())
  orderNumber           String      @unique @default(cuid())

  // Purchaser
  purchaserUserId       String
  purchaserUser         User        @relation("OrderPurchaser", fields: [purchaserUserId], references: [id])

  // Attribution
  attributedDesignerId  String?
  attributedDesigner    User?       @relation("OrderAttributedDesigner", fields: [attributedDesignerId], references: [id])
  attributedRepId       String?
  attributedRep         User?       @relation("OrderAttributedRep", fields: [attributedRepId], references: [id])

  // Vendor
  vendorId              String
  vendor                Organization @relation(fields: [vendorId], references: [id])

  // Financial (all in USD cents to avoid decimal issues)
  retailAmountCents     Int
  tradeAmountCents      Int
  marginAmountCents     Int

  // Split allocation (cents)
  folioAmountCents          Int
  designerCreditAmountCents Int
  repCreditAmountCents      Int
  consumerDiscountCents     Int

  // Credit application
  creditAppliedCents    Int         @default(0)
  cashPaidCents         Int

  // Fulfillment
  fulfillmentMethod     FulfillmentMethod
  vendorOrderRef        String?
  fulfillmentNotes      String?

  status                OrderStatus @default(PENDING)

  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  items                 OrderItem[]
  earnedCredits         CreditTransaction[] @relation("EarnedFromOrder")
  redeemedCredits       CreditTransaction[] @relation("RedeemedOnOrder")

  @@index([purchaserUserId])
  @@index([attributedDesignerId])
  @@index([vendorId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id              String    @id @default(cuid())
  orderId         String
  order           Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId       String
  product         Product   @relation(fields: [productId], references: [id])

  quantity        Int       @default(1)
  retailPriceCents Int
  tradePriceCents  Int

  // Attribution source
  productTagId    String?
  productTag      ProductTag? @relation(fields: [productTagId], references: [id])

  createdAt       DateTime  @default(now())

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model VendorTradeAccount {
  id                String          @id @default(cuid())
  vendorId          String          @unique
  vendor            Organization    @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  accountType       TradeAccountType

  // Trade terms
  discountPercent   Decimal         @db.Decimal(5, 2) // e.g., 20.00 for 20%
  paymentTerms      String?         // "Net 30", etc.

  // Credentials (store encrypted or use secrets manager)
  loginUrl          String?
  credentialsJson   String?         // Encrypted JSON

  // Contact for quote/rep methods
  contactEmail      String?
  contactPhone      String?
  defaultRepId      String?
  defaultRep        User?           @relation(fields: [defaultRepId], references: [id])

  // Status
  isActive          Boolean         @default(true)
  lastVerifiedAt    DateTime?

  notes             String?

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@map("vendor_trade_accounts")
}
