  name        String
  slug        String  @unique
  description String? @db.Text

  // Location
  address String
  city    String
  state   String
  country String @default("USA")

  // Development details
  totalUnits         Int
  status             DevelopmentStatus @default(PLANNING)
  expectedCompletion DateTime?

