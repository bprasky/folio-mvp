// Rooms within a unit type
model UnitTypeRoom {
  id         String   @id @default(cuid())
  unitTypeId String
  unitType   UnitType @relation(fields: [unitTypeId], references: [id], onDelete: Cascade)

  name String // "Primary Bathroom"
  type String // "BATH"

