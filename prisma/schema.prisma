// Bio interview responses (preserves raw answers for reprocessing)
model OrgBioInterview {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Layer 1 responses
  originStory         String?  @db.Text
  philosophyStatement String?
  projectTypes        String[]
  location            String?
  serviceRegions      String[]
  idealClient         String?  @db.Text

  // Layer 2 responses (contextual follow-ups)
  layer2Responses Json? // { questionId: answer } for contextual questions

  // Layer 3 responses (proof points)
  representativeProjectId String?
  recognitionMentions     String? @db.Text
  collaboratorMentions    String? @db.Text

  // AI-generated outputs
  fullBio            String? @db.Text
  shortBio           String? // 80 words for cards
  pullQuotes         Json? // string[]
  philosophyTagline  String? // one-liner
  processDescription String? @db.Text

  generatedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Interview-first profile: conversational interview format
  conversationalAnswers Json?   // { questionId: answer } for 7-question conversational format
  interviewFormat       String  @default("layered") // "layered" (legacy) or "conversational" (new)

  // Bio import
  importedBioText       String?   @db.Text
  importedBioUrl        String?
  importedBioAnalyzedAt DateTime?
  bioImportType         String    @default("FRESH") // FRESH | IMPORTED_URL | IMPORTED_TEXT

