  editorialScore Float
  createdAt      DateTime          @default(now())
  project        Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  editorial      ProjectPost       @relation(fields: [editorialId], references: [id], onDelete: Cascade)
  category       EditorialCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([projectId, categoryId])
  @@index([categoryId])
  @@index([editorialId])
  @@map("editorial_assignment")
}

model EditorialEdition {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  intro       String
  categoryIds String[]
  projectIds  String[]
  publishedAt DateTime?
  metrics     Json
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("editorial_edition")
}

// Instagram Campaign System
model InstagramCampaign {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Campaign metadata
  preset      String // "compact" | "standard" | "complete" | "custom"
  totalPosts  Int // e.g., 8-12 posts
  generatedAt DateTime @default(now())
  expiresAt   DateTime // 30 days from generation

  // Download URL for ZIP file
  downloadUrl String?

  // Settings
  formats         String[] // ["square", "portrait", "story"]
  includeRooms    Boolean  @default(true)
  includeProducts Boolean  @default(true)
  includeQuotes   Boolean  @default(true)
  includeDetails  Boolean  @default(false)

  posts InstagramCampaignPost[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@map("instagram_campaigns")
}

model InstagramCampaignPost {
  id         String            @id @default(cuid())
  campaignId String
  campaign   InstagramCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  // Post metadata
  postType    String // "launch" | "room_spotlight" | "product_feature" | "quote" | "detail" | "closer"
  sequenceNum Int // 1, 2, 3... (for "1 of 6")

  // Content
  title    String?
  caption  String
  hashtags String[]

  // Assets
  format     String[] // ["square", "portrait", "story"]
  imageIds   String[] // ProjectImage IDs used
  productIds String[] // Products featured (if applicable)
  roomName   String? // Room featured (if applicable)

  // Generated file URLs
  fileUrls Json? // { square: "url", portrait: "url", story: "url" }

  createdAt DateTime @default(now())

  @@index([campaignId, sequenceNum])
  @@map("instagram_campaign_posts")
}

enum EditorialInterviewStatus {
  IN_PROGRESS
  COMPLETED
  PUBLISHED
}

model EditorialInterview {
  id        String  @id @default(cuid())
  projectId String  @unique @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  status EditorialInterviewStatus @default(IN_PROGRESS)

  selectedQuestionIds String[] @map("selected_question_ids")

  // Room pacing: tracks per-room interview progress
  roomProgress Json? @map("room_progress")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  answers EditorialInterviewAnswer[]

  // Real-time interview sessions that contributed to this editorial
  realtimeSessions RealtimeInterviewSession[]

  @@map("editorial_interviews")
}

model EditorialInterviewAnswer {
  id          String             @id @default(cuid())
  interviewId String             @map("interview_id")
  interview   EditorialInterview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  questionId     String  @map("question_id")
  questionText   String? @map("question_text") // The actual question text for editorial generation
  isFollowUp     Boolean @default(false) @map("is_follow_up")
  parentAnswerId String? @map("parent_answer_id") // For follow-ups, links to Layer 1 answer

  answerText    String  @map("answer_text")
  audioUrl      String? @map("audio_url") // Optional: retained audio
  inputModality String  @default("text") @map("input_modality") // "text" | "voice" | "mixed"

  // AI-extracted metadata (optional)
  confidenceScore    Float?   @map("confidence_score")
  inferredPriorities String[] @map("inferred_priorities")
  softConstraints    String[] @map("soft_constraints")

  // NEW: Contextual question linking
  linkedImageId             String? @map("linked_image_id")
  linkedProductId           String? @map("linked_product_id")
  questionSource            String? @map("question_source") // 'base_question' | 'ai_classification' | 'follow_up'
  aiClassificationAttribute String? @map("ai_classification_attribute") // e.g., "color:sage green"

  // Room pacing: associates answer with a specific room
  roomId      String? @map("room_id")
  isCrossRoom Boolean @default(false) @map("is_cross_room")

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  // Removed - AttributeVerification doesn't have interviewAnswerId field

  @@index([interviewId])
  @@index([questionId])
  @@index([linkedImageId])
  @@index([roomId])
  @@map("editorial_interview_answers")
}

// ============================================================
// PREDICTIVE MARKET LAYER - Context Graph & Signals
// ============================================================

model ContextSignal {
  id         String   @id @default(cuid())
  userId     String?
  vendorId   String?
  productId  String?
  materialId String?
  projectId  String?
  eventId    String?
  action     String // "view" | "save" | "add_to_project" | "rsvp" | "feature_click" | "search"
  tags       String[] // ["brass","emerald","mid-century",...]
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([userId, action, createdAt])
  @@index([productId, projectId, action])
  @@index([eventId, action])
  @@map("context_signals")
}

model Embedding {
  id        String   @id @default(cuid())
  nodeType  String
  nodeId    String
  vector    Bytes
  updatedAt DateTime @default(now())

  @@unique([nodeType, nodeId])
  @@index([nodeType])
  @@map("embeddings")
}

model GraphEdge {
  id        String   @id @default(cuid())
  srcType   String
  srcId     String
  dstType   String
  dstId     String
  kind      String // "uses" | "saves" | "includes" | "attends" | "hosts" | "associated_with" | "affinity"
  weight    Float
  decayAt   DateTime
  updatedAt DateTime @default(now())

  @@index([srcType, srcId])
  @@index([dstType, dstId])
  @@index([kind])
  @@index([updatedAt])
  @@map("graph_edges")
}

model MarketSignal {
  id         String   @id @default(cuid())
  nodeType   String
  nodeId     String
  liquidity  Float
  momentum   Float
  confidence Float
  window     String
  updatedAt  DateTime @default(now())

  @@index([nodeType, nodeId])
  @@index([updatedAt])
  @@map("market_signals")
}

model SpendRecommendation {
  id             String   @id @default(cuid())
  vendorId       String
  scopeType      String // "event" | "product" | "category"
  scopeId        String
  recommendedUsd Float
  rationale      Json
  updatedAt      DateTime @default(now())

  @@index([vendorId, scopeType, scopeId])
  @@map("spend_recommendations")
}

// NOTE (designer onboarding):
// This model stores designer brand identity information (logo, colors, fonts).
// Created automatically when a designer account is first created.
model DesignerBrandProfile {
  id         String @id @default(cuid())
  designerId String @unique
  designer   User   @relation(fields: [designerId], references: [id], onDelete: Cascade)

  logoImageUrl   String? // URL to uploaded logo
  primaryColor   String? // hex color
  secondaryColor String? // hex color
  accentColor    String? // hex color
  fontHeading    String? // e.g. "Suisse Intl"
  fontBody       String? // e.g. "Inter"

  websiteUrl String? // used later for AI brand scan

  setupCompletedAt DateTime?
  setupSkippedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("designer_brand_profiles")
}

model DesignerBrandAssets {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Visual identity
  logoLightUrl String? // Logo for light backgrounds
  logoDarkUrl  String? // Logo for dark backgrounds
  logomarkUrl  String? // Icon/mark only version

  // Color palette (hex values)
  primaryColor    String? // Main brand color
  secondaryColor  String? // Supporting color
  accentColor     String? // Highlight/CTA color
  backgroundColor String? // Preferred background

  // Typography preferences
  headingFont String? // e.g., "Orpheus Pro", "Helvetica Neue"
  bodyFont    String? // e.g., "Inter", "Georgia"

  // Mood/inspiration (even before projects exist)
  moodImageUrls    String[] // Up to 6 mood images
  inspirationNotes String? // Free text about their aesthetic

  // References
  inspiredByDesigners    String[] // Names or handles
  inspiredByPublications String[] // e.g., "Architectural Digest", "Kinfolk"

  // Brand voice
  tagline         String? // One-liner
  brandAdjectives String[] // e.g., ["warm", "minimal", "collected"]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("designer_brand_assets")
}

model AttributeVerification {
  id               String   @id @default(cuid())
  projectId        String
  imageId          String?
  attributeType    String
  aiValue          String
  verified         Boolean?
  correctedValue   String?
  questionAsked    String
  designerResponse String?
  createdAt        DateTime @default(now())

  project Project       @relation("ProjectAttributeVerifications", fields: [projectId], references: [id], onDelete: Cascade)
  image   ProjectImage? @relation("ImageAttributeVerifications", fields: [imageId], references: [id], onDelete: SetNull)

  @@index([attributeType, verified])
  @@index([projectId])
  @@index([imageId])
  @@map("attribute_verifications")
}

model DesignerDecision {
  id                 String   @id @default(cuid())
  designerId         String
  projectId          String?
  decisionType       String
  choice             String
  choiceId           String?
  choiceType         String?
  roomType           String?
  imageId            String?
  productTagId       String?
  selectionId        String?
  reasoning          String?
  alternatives       Json?    @default("[]")
  tradeoffs          String?
  convictionLevel    Float?
  isClientDriven     Boolean  @default(false)
  clientContext      String?
  clientBriefExcerpt String?
  pairedWith         Json?    @default("[]")
  influences         String[]
  clientReaction     String?
  outcomeNotes       String?
  captureSource      String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  designer User          @relation(fields: [designerId], references: [id], onDelete: Cascade)
  project  Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  image    ProjectImage? @relation(fields: [imageId], references: [id], onDelete: SetNull)

  @@index([designerId])
  @@index([designerId, decisionType])
  @@index([designerId, roomType])
  @@index([projectId])
  @@map("designer_decision")
}

model DesignerVoiceProfile {
  id                     String    @id @default(cuid())
  designerId             String    @unique
  vocabularyFrequency    Json?     @default("{}")
  signaturePhrases       String[]
  terminologyPreferences Json?     @default("{}")
  avgSentenceLength      Float?
  sentenceStructures     Json?     @default("[]")
  formalityLevel         Float?
  enthusiasmLevel        Float?
  technicalDepth         Float?
  reasoningStyle         String?
  commonJustifications   String[]
  voiceEmbedding         Bytes?
  interviewAnswerCount   Int       @default(0)
  decisionReasoningCount Int       @default(0)
  lastAnalyzedAt         DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  designer User @relation(fields: [designerId], references: [id], onDelete: Cascade)

  @@map("designer_voice_profile")
}

// Designer reasoning profile - captures HOW a designer thinks and decides,
// not just their aesthetic preferences. Used to inform AI consultation guidance.
model DesignerReasoningProfile {
  id     String @id @default(cuid())
  userId String @unique

  // Derived from bio and brand profile - their own words
  statedApproach String? // Their description of how they work
  statedValues   String[] // What they say matters to them

  // Derived from project selections (ProductTag patterns)
  materialTendencies Json?   @default("{}") // { "natural_stone": 0.7, "engineered": 0.3 }
  pricePointPattern  String? // "investment_focused" | "value_conscious" | "balanced" | "context_dependent"
  vendorAffinities   Json?   @default("[]") // [{ vendorId, vendorName, frequency }]

  // Derived from interview content
  decisionPatterns Json?    @default("[]") // How they explain choices
  tradeoffExamples Json?    @default("[]") // [{ context, reasoning }]
  quotesOnApproach String[] // Verbatim quotes about their philosophy

  // Derived from editorial/project narratives
  explanationExamples Json? @default("[]") // [{ topic, explanation }]

  // Metadata
  lastComputedAt  DateTime?
  dataSourcesUsed String[] // ["bio", "projects", "interviews", "editorial"]
  confidenceScore Float? // How much data we have (0-1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("designer_reasoning_profiles")
}

model OrbQuestion {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  investorToken String? // optional, will be useful later for investor portal
  nodeId        String? // NodeId as string (e.g. "editorials", "atelier")
  edgeFrom      String? // optional: from-node id
  edgeTo        String? // optional: to-node id

  question String
  answer   String

  // simple categorization tags if needed
  tags String? // comma-separated tags for now

  @@map("orb_questions")
}

// ============================================================
// ATELIER - Designer/Vendor Fingerprint System
// ============================================================

enum AtelierOwnerType {
  DESIGNER
  VENDOR
}

enum AtelierNodeType {
  STYLE
  ROOM_TYPE
  MATERIAL
  VENDOR
  PRODUCT_CATEGORY
  COLOR_CLUSTER
  BEHAVIOR
}

enum AtelierRelationType {
  PROJECT_ROOM_FOCUS
  FREQUENT_VENDOR
  PREFERS
  STYLE_MATERIAL
  STYLE_COLOR
}

enum AtelierSignalSourceType {
  PROJECT
  SELECTION
  SAVE
  TAG
  INTERVIEW
  BEHAVIOR
}

model AtelierFingerprint {
  id             String           @id @default(cuid())
  ownerType      AtelierOwnerType
  designerId     String?
  vendorId       String?
  completeness   Float            @default(0)
  lastComputedAt DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  // Versioning for consultation attribution
  version  Int   @default(1)
  snapshot Json? // Computed fingerprint snapshot for deployments

  nodes AtelierNode[]
  edges AtelierEdge[]

  // Deployment relations
  deployments AtelierDeployment[]

  @@index([ownerType, designerId])
  @@index([ownerType, vendorId])
  @@map("atelier_fingerprints")
}

model AtelierNode {
  id            String          @id @default(cuid())
  fingerprintId String
  nodeType      AtelierNodeType
  label         String
  weight        Float           @default(0)
  metadata      Json?
  createdAt     DateTime        @default(now())

  fingerprint AtelierFingerprint @relation(fields: [fingerprintId], references: [id], onDelete: Cascade)
  sourceEdges AtelierEdge[]      @relation("SourceNode")
  targetEdges AtelierEdge[]      @relation("TargetNode")

  @@index([fingerprintId, nodeType])
  @@map("atelier_nodes")
}

model AtelierEdge {
  id            String              @id @default(cuid())
  fingerprintId String
  sourceNodeId  String
  targetNodeId  String
  relationType  AtelierRelationType
  weight        Float               @default(0)
  createdAt     DateTime            @default(now())

  fingerprint AtelierFingerprint @relation(fields: [fingerprintId], references: [id], onDelete: Cascade)
  sourceNode  AtelierNode        @relation("SourceNode", fields: [sourceNodeId], references: [id], onDelete: Cascade)
  targetNode  AtelierNode        @relation("TargetNode", fields: [targetNodeId], references: [id], onDelete: Cascade)

  @@index([fingerprintId])
  @@index([sourceNodeId])
  @@index([targetNodeId])
  @@map("atelier_edges")
}

model AtelierSignal {
  id         String                  @id @default(cuid())
  ownerType  AtelierOwnerType
  designerId String?
  vendorId   String?
  sourceType AtelierSignalSourceType
  sourceId   String?
  key        String
  weight     Float                   @default(1)
  metadata   Json?
  createdAt  DateTime                @default(now())

  @@index([ownerType, designerId])
  @@index([ownerType, vendorId])
  @@index([key])
  @@map("atelier_signals")
}

model ImpersonationLog {
  id           String    @id @default(cuid())
  adminId      String
  targetUserId String
  startedAt    DateTime  @default(now())
  endedAt      DateTime?
  admin        User      @relation("AdminImpersonations", fields: [adminId], references: [id])
  targetUser   User      @relation("UserImpersonations", fields: [targetUserId], references: [id])

  @@index([adminId])
  @@index([targetUserId])
  @@map("impersonation_logs")
}

// ============================================================
// IMPORT AGENT - AI-powered project import from presentations
// ============================================================

model ImportSession {
  id     String @id @default(uuid())
  userId String

  sourceType ImportSourceType // PRESENTATION, WEBSITE, BULK_IMAGES
  sourceUrl  String? // Original URL if website import
  fileName   String? // Original filename if upload

  status ImportSessionStatus @default(PROCESSING)
  // PROCESSING → ANALYZED → READY_FOR_REVIEW → COMPLETED → FAILED

  projectId String? // Created/target project

  // Metrics
  totalImages   Int @default(0)
  totalProducts Int @default(0)
  verifiedTags  Int @default(0)

  // Processing metadata
  processingMeta Json? // Agent state, partial results
  errorMessage   String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  pendingTags PendingProductTag[]

  @@index([userId])
  @@index([status])
  @@map("import_sessions")
}

model PendingProductTag {
  id              String        @id @default(uuid())
  importSessionId String
  importSession   ImportSession @relation(fields: [importSessionId], references: [id], onDelete: Cascade)

  // Image reference
  projectImageId String?
  tempImageUrl   String? // Before project image is created

  // Position on image
  x Float
  y Float

  // Agent's detection
  description String // "Navy velvet sofa with brass legs"
  category    String // FURNITURE, LIGHTING, etc.
  searchQuery String // Query used for attribution

  // Agent's attribution suggestions
  suggestions   Json // Array of ProductAttribution objects
  topSuggestion Json? // Best match for quick display

  // Confidence
  detectionConfidence   String // high, medium, low
  attributionConfidence String? // high, medium, low (after search)

  // Room type detected from image analysis
  roomType String?

  // Extracted spec data from PDF text (populated when PDF has text annotations)
  extractedVendor     String? // Brand/vendor name from text
  extractedPrice      Int? // Price in cents
  extractedDimensions String? // Dimensions string (e.g., "72W x 36D x 30H")
  extractedSku        String? // SKU or model number
  extractedMaterial   String? // Material description
  extractedProductUrl String? // Product URL if found

  // Verification status
  status PendingTagStatus @default(UNREVIEWED)
  // UNREVIEWED → CONFIRMED → CORRECTED → DISMISSED

  // If confirmed/corrected, link to actual product
  confirmedProductId String?

  // If corrected, what did designer change?
  correctionNote String?

  // Resulting ProductTag (after confirmation)
  resultingTagId String? @unique

  createdAt  DateTime  @default(now())
  reviewedAt DateTime?

  @@index([importSessionId, status])
  @@index([status])
  @@map("pending_product_tags")
}

enum ImportSourceType {
  PRESENTATION
  WEBSITE
  BULK_IMAGES
}

enum ImportSessionStatus {
  PROCESSING
  ANALYZED
  READY_FOR_REVIEW
  COMPLETED
  FAILED
}

enum PendingTagStatus {
  UNREVIEWED
  CONFIRMED
  CORRECTED
  DISMISSED
}

// ============================================================
// WAITLIST - Email capture for Vendor/Individual signups
// ============================================================

model WaitlistSignup {
  id        String       @id @default(cuid())
  email     String
  type      WaitlistType
  createdAt DateTime     @default(now())

  @@unique([email, type])
  @@map("waitlist_signups")
}

enum WaitlistType {
