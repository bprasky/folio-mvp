// ============================================================
// VENDOR BOOST SYSTEM
// Testimonial marketplace for designer-vendor mentions
// ============================================================

enum BoostStatus {
  PENDING // Created, not yet notified
  NOTIFIED // Vendor has been notified
  VIEWED // Vendor has viewed the opportunity
  BOOSTED // Vendor has boosted
  DECLINED // Vendor explicitly declined
  EXPIRED // Passed expiration without action
}

// Designer Shop Boost Status (separate from BoostOpportunity system)
enum ShopBoostStatus {
  PENDING
  APPROVED
  ACTIVE
  DECLINED
  EXPIRED
  CANCELLED
}

model BoostOpportunity {
  id String @id @default(cuid())

  // Source
  projectId  String
  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  questionId String // Reference to the question asked

  // The content
  designerId String
  designer   User         @relation("DesignerBoostOpportunities", fields: [designerId], references: [id])
  vendorId   String
  vendor     Organization @relation("VendorBoostOpportunities", fields: [vendorId], references: [id])

  // Quote details
  fullAnswer         String   @db.Text
  suggestedPullQuote String?  @db.Text
  productIds         String[] // Products mentioned
  sentiment          String // positive, neutral

  // Status
  status      BoostStatus @default(PENDING)
  notifiedAt  DateTime?
  viewedAt    DateTime?
  respondedAt DateTime?
  expiresAt   DateTime // Boost opportunities expire after 14 days

  // If boosted
  boost Boost?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vendorId, status])
  @@index([projectId])
  @@index([designerId])
  @@map("boost_opportunities")
}

model Boost {
  id String @id @default(cuid())

  // Source
  opportunityId String           @unique
  opportunity   BoostOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  // Vendor
  vendorId    String
  vendor      Organization @relation("VendorBoosts", fields: [vendorId], references: [id])
  boostedById String // User who approved the boost
  boostedBy   User         @relation("UserBoosts", fields: [boostedById], references: [id])

  // Content (may be edited from suggested)
  pullQuote String @db.Text

  // Placement preferences
  showInArticle    Boolean @default(true)
  showOnVendorPage Boolean @default(true)
  showInFeed       Boolean @default(false) // Premium placement

  // Display settings
  priority     Int       @default(0) // Higher = more prominent
  displayUntil DateTime? // Optional expiration

  // Billing
  boostTier   String // 'included', 'premium', 'featured'
  amountCents Int       @default(0)
  billedAt    DateTime?

  // Stats
  impressions Int @default(0)
  clicks      Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vendorId])
  @@map("boosts")
}

// ─── In Context Boost System ─────────────────────────────────────────────────
// When a designer tags a product in a project, vendors must boost the tag
// to earn placement on the product page's "In Context" section.
// This creates a flywheel: vendor boost → designer credit → follow-up Q&A →
// richer product content without re-editing articles.

model InContextBoost {
  id String @id @default(cuid())

  // The tag being boosted (designer tagged this product on this image)
  productTagId String
  productTag   ProductTag @relation(fields: [productTagId], references: [id], onDelete: Cascade)

  // Product page where this will appear in the In Context section
  productId String
  product   Product @relation("ProductInContextBoosts", fields: [productId], references: [id], onDelete: Cascade)

  // Article/post where the product is featured
  projectPostId String?
  projectPost   ProjectPost? @relation("PostInContextBoosts", fields: [projectPostId], references: [id], onDelete: SetNull)

  // Designer who tagged the product
  designerId String
  designer   User @relation("DesignerInContextBoosts", fields: [designerId], references: [id])

  // Vendor being asked to boost (organization or user)
  vendorId    String? // Organization ID (if vendor account exists)
  vendorUserId String? // Vendor user ID (if vendor account exists)

  // Rep outreach (if no vendor account)
  repEmail String? // Sales rep email entered by designer
  repName  String? // Sales rep name

  // Status flow: PENDING_REVIEW → NOTIFIED → VIEWED → APPROVED/DECLINED/EXPIRED
  status     String   @default("PENDING_REVIEW")
  notifiedAt DateTime?
  viewedAt   DateTime?
  reviewedAt DateTime?
  expiresAt  DateTime? // Opportunity expires after N days

  // Review outcome
  accuracyConfirmed Boolean @default(false) // Vendor confirmed tag accuracy
  declineReason     String?

  // Follow-up Q&A (triggered on approval)
  followUpQuestion    String?  @db.Text // Question for designer about this product usage
  followUpAnswer      String?  @db.Text // Designer's response
  followUpRequestedAt DateTime?
  followUpAnsweredAt  DateTime?

  // Display settings
  displayUntil DateTime? // Optional boost expiration
  boostTier    String    @default("included") // included, premium, featured

  // Photo usage rights — vendor earns right to use tagged image for promotion
  photoRightsGranted Boolean @default(false) // Designer grants on boost acceptance
  photoUsageScope    String? // 'product_page', 'magazine', 'social', 'all'

  // Revenue tracking — per-click/per-like, vendor pays, Folio takes 30%
  impressions           Int     @default(0)
  clicks                Int     @default(0)
  likes                 Int     @default(0)
  lastBilledImpressions Int     @default(0) // Impressions at last billing
  lastBilledClicks      Int     @default(0) // Clicks at last billing
  designerPayoutCents   Int     @default(0) // 70% of revenue
  folioRevenueCents     Int     @default(0) // 30% of revenue
  vendorSpendCents      Int     @default(0) // Total vendor spend
  lastBilledAt          DateTime?

  // Photographer licensing
  photographerId           String?
  photographerLicenseCents Int     @default(0) // Flat fee per boost

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productTagId]) // One boost per tag
  @@index([productId, status])
  @@index([vendorId, status])
  @@index([designerId])
  @@index([status])
  @@map("in_context_boosts")
}

// ─── Vendor Content System ───────────────────────────────────────────────────
// Vendor-authored articles generated from Folio's curated editorial prompts.
// Vendors answer questions → AI generates editorial content → published to feed.

model VendorPost {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation("OrgVendorPosts", fields: [organizationId], references: [id], onDelete: Cascade)
  authorId       String
  author         User         @relation("UserVendorPosts", fields: [authorId], references: [id])

  title          String
  slug           String       @unique
  content        String       @db.Text
  excerpt        String?
  heroImageUrl   String?
  contentType    String       @default("article") // article, product_launch, collection_spotlight

  // Source prompt tracking
  promptId       String?
  promptAnswers  Json?

  status         String       @default("DRAFT") // DRAFT, PUBLISHED
  publishedAt    DateTime?

  // Engagement
  views          Int          @default(0)

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, status])
  @@index([slug])
  @@map("vendor_posts")
}

// Curated editorial prompts that Folio serves to vendors for content creation.
// Prompts can be triggered by events (new boost, product launch, seasonal).
model VendorPrompt {
  id             String       @id @default(cuid())
  organizationId String?      // Null = global prompt template; set = org-specific

  title          String       // Short display title
  question       String       @db.Text // The actual prompt question
  category       String       @default("general") // general, product, project, seasonal, boost_followup

  // Context that triggered this prompt
  triggerType    String?      // boost_approved, product_added, seasonal, manual
  triggerRef     String?      // Reference ID (boostId, productId, etc.)

  // Designer attribution — whose work inspired this prompt
  relatedDesignerId  String?
  relatedProductId   String?

  // State
  status         String       @default("ACTIVE") // ACTIVE, ANSWERED, DISMISSED, EXPIRED
  answeredAt     DateTime?
  answeredPostId String?      // Links to the VendorPost generated from this prompt

  priority       Int          @default(0) // Higher = more prominent
  expiresAt      DateTime?

  createdAt      DateTime     @default(now())

  @@index([organizationId, status])
  @@index([category])
  @@map("vendor_prompts")
}

// Vendor invite signals for vendors not yet on platform
model VendorInviteSignal {
  id          String    @id @default(cuid())
  vendorName  String
  signalType  String // 'TESTIMONIAL_AVAILABLE', 'PRODUCT_TAG', etc.
  projectId   String?
  designerId  String?
  metadata    Json?
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([vendorName])
  @@index([signalType])
  @@map("vendor_invite_signals")
}

// In-app notification system
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // 'BOOST_OPPORTUNITY', 'TESTIMONIAL_BOOSTED', etc.
  title     String
  body      String
  actionUrl String?
  metadata  Json?
  read      Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, read])
  @@index([createdAt])
  @@map("notifications")
}

// Product search logging for business intelligence
// Tracks what designers search for to build vendor demand signals
model ProductSearchLog {
  id String @id @default(cuid())

  // Who searched
  userId String
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgId  String? // Designer's organization if applicable

  // What they searched for
  searchType  String // 'FOLIO_SEARCH', 'AI_COMPLETE', 'URL_IMPORT'
  brandName   String? // Extracted or searched brand
  productName String? // Product name searched
  searchQuery String? // Raw search query

  // Context
  selectionId String? // If search was for a specific selection
  projectId   String? // Which project it was for

  // Results
  wasSuccessful    Boolean @default(false)
  matchedProductId String? // If found a match in Folio
  resultData       Json? // Additional result metadata

  // Timestamps
  createdAt DateTime @default(now())

  @@index([brandName])
  @@index([userId])
  @@index([searchType])
  @@index([createdAt])
  @@map("product_search_logs")
}

// Designer's personal directory of vendor rep contacts
// Allows designers to store and manage rep relationships
model VendorRepContact {
  id String @id @default(cuid())

  // Owner (designer)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Rep information
  repName  String
  repEmail String?
  repPhone String?
  repTitle String? // e.g., "Territory Sales Rep", "Account Manager"

  // Vendor/Brand association
  vendorName  String // Brand they represent (e.g., "FOURHANDS", "RH")
  vendorOrgId String? // Link to Organization if vendor is on platform

  // Preferences
  preferredContact String? // 'email', 'phone', 'text'
  notes            String? @db.Text // Personal notes about this rep

  // Trade account info with this rep/vendor
  hasTradeAccount    Boolean  @default(false)
  tradeAccountNumber String?
  tradeDiscount      Decimal? @db.Decimal(5, 2) // e.g., 40.00 for 40%

  // Status
  isActive        Boolean   @default(true)
  lastContactedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, vendorName]) // One rep per vendor per designer
  @@index([userId])
  @@index([vendorName])
  @@map("vendor_rep_contacts")
}

// ============================================================
// ORGANIZATION ONBOARDING SYSTEM
