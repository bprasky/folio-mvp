FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg fontconfig ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npx prisma generate && mkdir -p /usr/share/fonts/folio && cp node_modules/@fontsource/inter/files/inter-latin-400-normal.woff2 /usr/share/fonts/folio/ && fc-cache -f
USER node
ENV NODE_ENV=production
CMD ["node", "scripts/interview-media-worker.cjs"]
